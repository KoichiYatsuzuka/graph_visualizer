import ..environment as env
import[cpp-dll] ..raylib_bridge.raylib_bridge as rl

# ---- 化学種を円で描くときの大きさ・文字・印 ----
const FULL_QUANTITY_RADIUS = 100.0          # quantity が 1 のときの円の半径 [pixel]
const MINIMUM_RADIUS = 10.0                 # 円の半径の下限 [pixel]（quantity が小さくても、0 以下でもこれより小さくしない）
const LOG10_OF_TWO = 0.30102999566398120    # log10(2)。半径 = FULL_QUANTITY_RADIUS * quantity ** LOG10_OF_TWO
                                            # （= FULL_QUANTITY_RADIUS * 2 ** log10(quantity)。quantity が 1/10 になるごとに半分）
const NAME_FONT_SIZE = 20                   # 円の中心に描く名前の文字の大きさ [pixel]
const QUANTITY_FONT_SIZE = 16               # 名前の下に描く量の文字の大きさ [pixel]
const LABEL_LINE_GAP = 2                    # 名前の行と量の行の間 [pixel]
const QUANTITY_FORMAT = ".3g"               # 量の書式（format の書式指定。0.001 → "0.001"・1.0 → "1"）
const LABEL_BRIGHTNESS_THRESHOLD = 150.0    # 塗りの明るさ（0〜255）がこれ以上なら濃い文字、未満なら白い文字にする
const HIGHLIGHT_MARK_TEXT = "[clicked]"     # クリックされた化学種の円の上に描く印（raylib の既定のフォントは ASCII だけ）
const HIGHLIGHT_MARK_FONT_SIZE = 20         # 印の文字の大きさ [pixel]
const HIGHLIGHT_MARK_GAP = 4                # 円の縁と印の間 [pixel]

# ---- 反応を矢印で描くときの太さ・流れる速さ・形 ----
# 速度定数・反応速度の log10 を SCALE_LOWER_VALUE〜SCALE_UPPER_VALUE の間で線形に写す（範囲の外は端の値のまま）
const SCALE_LOWER_VALUE = 1.0e-2            # これ以下の速度定数・反応速度は最小の速さ・太さ
const SCALE_UPPER_VALUE = 1.0e6             # これ以上の速度定数・反応速度は最大の速さ・太さ
const MINIMUM_FLOW_CYCLES_PER_SECOND = 0.5  # グラデーションが流れる最小の速さ [周期/画面の秒]
const MAXIMUM_FLOW_CYCLES_PER_SECOND = 4.5  # グラデーションが流れる最大の速さ [周期/画面の秒]
const MINIMUM_ARROW_THICKNESS = 5.0         # 矢印の最小の太さ [pixel]
const MAXIMUM_ARROW_THICKNESS = 20.0        # 矢印の最大の太さ [pixel]
const REACTION_ARROW_BEND = 0.5             # 矢印の曲がり具合 = 曲率 × 弦の長さ（0.5 で弧の膨らみは弦の長さの約 1/16。長さによらず同じ形）
const REACTION_CENTER_RADIUS = 6.0          # 反応の中心に描く点の半径の最小 [pixel]（矢印の太さの半分より小さくはしない）

let REACTION_ARROW_START_COLOR = rl.Color(255, 200, 200, 255)   # 矢印のグラデーションの色（淡い → 鮮やか → 濃い → 淡い が流れる）
let REACTION_ARROW_MIDDLE_COLOR = rl.Color(230, 41, 55, 255)
let REACTION_ARROW_END_COLOR = rl.Color(90, 0, 20, 255)         # 矢じりの色
let REACTION_CENTER_COLOR = rl.Color(90, 0, 20, 255)            # 反応の中心の点の色

let CANVAS_BACKGROUND_COLOR = rl.Color(245, 245, 245, 255)  # 化学種を描く窓の背景の色（円からはみ出す文字の色をこれに合わせて選ぶ）
let DARK_LABEL_COLOR = rl.Color(30, 30, 30, 255)        # 明るい塗りの上の文字の色
let LIGHT_LABEL_COLOR = rl.Color(255, 255, 255, 255)    # 暗い塗りの上の文字の色
let HIGHLIGHT_MARK_COLOR = rl.Color(200, 0, 0, 255)     # クリックされた印の色

# radius_for_quantity — 化学種の量から、描く円の半径 [pixel] を決める
#   quantity: 化学種の量。1 で FULL_QUANTITY_RADIUS（100）、1/10 になるごとに半径は半分（0.1 で 50、0.01 で 25、0.001 で 12.5）
#   戻り値: FULL_QUANTITY_RADIUS * 2 ** log10(quantity)。MINIMUM_RADIUS（10）より小さければ MINIMUM_RADIUS。
#           quantity が 0 以下でも MINIMUM_RADIUS（log10 が決まらないので下限にする）。1 より大きい量は 100 より大きくなる（上限なし）
#   NaN・正の無限大は ValueError（半径が決まらない）
# 例: radius_for_quantity(0.1)  # 50.0（浮動小数点の誤差は 1e-12 程度）
#     radius_for_quantity(0.0)  # 10.0
fn radius_for_quantity(let quantity: float) -> float:
    if quantity != quantity:
        raise ValueError("quantity is NaN; the circle radius is undefined")
    if quantity == float("inf"):
        raise ValueError("quantity is infinite; the circle radius is undefined")
    if quantity <= 0.0:
        return MINIMUM_RADIUS
    let scaled_radius = FULL_QUANTITY_RADIUS * quantity ** LOG10_OF_TWO
    if scaled_radius < MINIMUM_RADIUS:
        return MINIMUM_RADIUS
    return scaled_radius

# label_color_on — 塗りの色の上で読みやすい文字の色を返す（明るい塗りには濃い灰色、暗い塗りには白）
#   fill_color: 文字の下の塗りの色
#   戻り値: 明るさ 0.299 r + 0.587 g + 0.114 b が LABEL_BRIGHTNESS_THRESHOLD 以上なら DARK_LABEL_COLOR、未満なら LIGHT_LABEL_COLOR
# 例: label_color_on(rl.Color(255, 161, 0, 255))   # DARK_LABEL_COLOR（橙は明るい）
#     label_color_on(rl.Color(0, 121, 241, 255))   # LIGHT_LABEL_COLOR（青は暗い）
fn label_color_on(let fill_color: rl.Color) -> rl.Color:
    let brightness = 0.299 * fill_color.r + 0.587 * fill_color.g + 0.114 * fill_color.b
    if brightness >= LABEL_BRIGHTNESS_THRESHOLD:
        return DARK_LABEL_COLOR
    return LIGHT_LABEL_COLOR

# label_color_for_line — 円の中心に描く文字の 1 行の色を決める。行が円に収まれば塗りに合わせ、はみ出すなら窓の背景に合わせる
#   （rl.measure_text を使うので init_window の後に呼ぶ）
#   text:       行の文字（ASCII）
#   font_size:  文字の大きさ [pixel]
#   radius:     円の半径 [pixel]
#   fill_color: 円の塗りの色
#   戻り値: 行の幅が直径以下なら label_color_on(fill_color)、直径より広ければ label_color_on(CANVAS_BACKGROUND_COLOR)
# 例: label_color_for_line("H2", 20, 100.0, rl.Color(0, 121, 241, 255))        # LIGHT_LABEL_COLOR（青い円に収まる）
#     label_color_for_line("vacancy", 20, 10.0, rl.Color(0, 121, 241, 255))   # DARK_LABEL_COLOR（明るい背景へはみ出す）
fn label_color_for_line(let text: str, let font_size: int, let radius: float, let fill_color: rl.Color) -> rl.Color:
    let text_width = rl.measure_text(text.encode("utf-8"), font_size)
    if text_width <= 2.0 * radius:
        return label_color_on(fill_color)
    return label_color_on(CANVAS_BACKGROUND_COLOR)

# draw_centered_text — 文字の行を、横の中心が center_x、上端が top_y になるように描く（begin_drawing と end_drawing の間で呼ぶ）
#   text:      描く文字（ASCII。raylib の既定のフォントは ASCII だけ）
#   center_x:  行の横の中心 [pixel]
#   top_y:     行の上端 [pixel]
#   font_size: 文字の大きさ [pixel]
#   color:     文字の色
# 例: draw_centered_text("H2", 400.0, 290, 20, DARK_LABEL_COLOR)
fn draw_centered_text(let text: str, let center_x: float, let top_y: int, let font_size: int, let color: rl.Color) -> None:
    let text_bytes = text.encode("utf-8")
    let text_width = rl.measure_text(text_bytes, font_size)
    let left_x = int(round(center_x)) - text_width // 2
    rl.draw_text(text_bytes, left_x, top_y, font_size, color)

# highlight_mark_top — クリックされた印の行の上端を決める。円の上に置き、窓の上にはみ出すなら円の下に置く
#   center_y: 円の中心の y [pixel]
#   radius:   円の半径 [pixel]
#   戻り値: 印の行の上端の y [pixel]
# 例: highlight_mark_top(300.0, 100.0)   # 176（= 300 - 100 - HIGHLIGHT_MARK_GAP - HIGHLIGHT_MARK_FONT_SIZE）
#     highlight_mark_top(50.0, 100.0)    # 154（上にはみ出すので円の下 = 50 + 100 + HIGHLIGHT_MARK_GAP）
fn highlight_mark_top(let center_y: float, let radius: float) -> int:
    let above_top = int(round(center_y - radius)) - HIGHLIGHT_MARK_GAP - HIGHLIGHT_MARK_FONT_SIZE
    if above_top >= 0:
        return above_top
    return int(round(center_y + radius)) + HIGHLIGHT_MARK_GAP

# Position — 化学種を描く位置。窓の大きさに対する割合で持つ（(0, 0) が左上、(1, 1) が右下）
#   メンバー:
#     x: float（private）— 横の位置。窓の幅に対する割合
#     y: float（private）— 縦の位置。窓の高さに対する割合（下向きが正）
#     to_screen(screen_width, screen_height) -> rl.Vector2 — 窓の中のピクセルの座標に換算する
#     __cast__[rl.Position_CPP]() -> rl.Position_CPP — C++ 側の座標クラスへ写す
# 例: let center = Position(0.5, 0.25).to_screen(800, 600)   # rl.Vector2(400.0, 150.0)
class Position:
    private:
    mut x: float
    mut y: float

    public:
    # to_screen — 窓の大きさに対する割合の位置を、窓の中のピクセルの座標（左上が (0, 0)）に換算する
    #   screen_width, screen_height: 窓の幅・高さ [pixel]（rl.get_screen_width() / rl.get_screen_height()）
    #   戻り値: rl.Vector2(x * screen_width, y * screen_height)
    # 例: Position(0.1, 0.9).to_screen(800, 600)   # rl.Vector2(80.0, 540.0)
    fn to_screen(let self, let screen_width: int, let screen_height: int) -> rl.Vector2:
        return rl.Vector2(self.x * screen_width, self.y * screen_height)

    # __cast__[rl.Position_CPP] — C++ 側の座標クラス rl.Position_CPP へ変換する（`p => rl.Position_CPP` で呼ぶ）
    #   戻り値: x, y をそのまま写した rl.Position_CPP（float32 に丸められる。ピクセルへの換算はしない）
    #   ⚠ let 仮引数への自動キャストは効かない（キャスト先が C++ の型だと静的エラー・2026-11-24 実測）。=> を書く。
    #   例: let position_cpp = vacancy.get_pos() => rl.Position_CPP
    fn __cast__[rl.Position_CPP](let self) -> rl.Position_CPP:
        return rl.Position_CPP(self.x, self.y)

# Species — 化学種。量（quantity）に応じた大きさの円として描き、クリックされた点が円に重なるかを判定できる
#   メンバー:
#     name: str（public・不変）— 化学種の名前（円の中心に描く。ASCII）
#     quantity: float（protected）— 化学種の量。円の半径を決める（radius_for_quantity）
#     pos: Position（protected）— 円の中心の位置（窓の大きさに対する割合）
#     color: rl.Color（protected・不変）— 円の塗りの色（作るときに渡す）
#     get_quantity() -> float / get_pos() -> Position — quantity / pos を返す
#     get_radius() -> float — 今の quantity での円の半径 [pixel]
#     get_screen_center(screen_width, screen_height) -> rl.Vector2 — 窓の中での円の中心 [pixel]
#     contains_screen_point(point, screen_width, screen_height) -> bool — 窓の中の点が円に重なるか
#     draw(screen_width, screen_height) -> None — 円と、中心に名前と量を描く
#     draw_highlight_mark(screen_width, screen_height) -> None — クリックされた印を円の上に描く
#     is_quantity_fixed() -> bool — 量が反応で変わらないか（既定 False。Solute は is_const）
#     change_quantity(amount) -> None — 量を増減させる（量が一定の化学種では何もしない）
# 例: mut h2 = Solute(name = "H2", pos = Position(0.5, 0.5), quantity = 0.1, color = rl.Color(0, 121, 241, 255), is_const = True)
#     h2.get_radius()   # 50.0（の近く）
trait Species:
    public:
    let name: str

    fn get_quantity(let self)->float:
        return self.quantity

    fn get_pos(let self)->Position:
        return self.pos

    # get_radius — 今の quantity で描く円の半径を返す
    #   戻り値: radius_for_quantity(quantity) [pixel]（quantity が NaN・正の無限大なら ValueError）
    # 例: Adsorbate(name = "H_ads", quantity = 0.01, pos = Position(0.5, 0.5), color = rl.Color(230, 41, 55, 255)).get_radius()   # 25.0
    fn get_radius(let self) -> float:
        return radius_for_quantity(self.quantity)

    # get_screen_center — 窓の中での円の中心の座標を返す
    #   screen_width, screen_height: 窓の幅・高さ [pixel]
    #   戻り値: pos を窓の大きさで換算した座標 [pixel]（左上が (0, 0)）
    # 例: species.get_screen_center(800, 600)   # pos が Position(0.5, 0.5) なら rl.Vector2(400.0, 300.0)
    fn get_screen_center(let self, let screen_width: int, let screen_height: int) -> rl.Vector2:
        return self.pos.to_screen(screen_width, screen_height)

    # contains_screen_point — 窓の中の点（マウスでクリックした位置など）が円に重なるかを返す
    #   point: 確かめる点 [pixel]（rl.get_mouse_position() の値）
    #   screen_width, screen_height: 窓の幅・高さ [pixel]
    #   戻り値: 円の中心からの距離が半径以下なら True（縁の上も True）
    # 例: species.contains_screen_point(rl.Vector2(400.0, 300.0), 800, 600)   # 中心なら True
    fn contains_screen_point(let self, let point: rl.Vector2, let screen_width: int, let screen_height: int) -> bool:
        let center = self.get_screen_center(screen_width, screen_height)
        let offset_x = point.x - center.x
        let offset_y = point.y - center.y
        let radius = self.get_radius()
        return offset_x * offset_x + offset_y * offset_y <= radius * radius

    # draw — color で塗った円を描き、中心に名前と量の 2 行を描く（begin_drawing と end_drawing の間で呼ぶ）
    #   screen_width, screen_height: 窓の幅・高さ [pixel]
    #   量は QUANTITY_FORMAT の書式。円が小さいと文字は円からはみ出す。文字の色は行ごとに、円に収まれば塗りの明るさ、
    #   はみ出せば窓の背景（CANVAS_BACKGROUND_COLOR）の明るさで決める（label_color_for_line）。
    # 例: species.draw(rl.get_screen_width(), rl.get_screen_height())
    fn draw(let self, let screen_width: int, let screen_height: int) -> None:
        let center = self.get_screen_center(screen_width, screen_height)
        let radius = self.get_radius()
        rl.draw_filled_circle(center.x, center.y, radius, self.color)
        let quantity_text = format(self.quantity, QUANTITY_FORMAT)
        let label_height = NAME_FONT_SIZE + LABEL_LINE_GAP + QUANTITY_FONT_SIZE
        let name_top = int(round(center.y)) - label_height // 2
        let quantity_top = name_top + NAME_FONT_SIZE + LABEL_LINE_GAP
        let name_color = label_color_for_line(self.name, NAME_FONT_SIZE, radius, self.color)
        let quantity_color = label_color_for_line(quantity_text, QUANTITY_FONT_SIZE, radius, self.color)
        draw_centered_text(self.name, center.x, name_top, NAME_FONT_SIZE, name_color)
        draw_centered_text(quantity_text, center.x, quantity_top, QUANTITY_FONT_SIZE, quantity_color)

    # draw_highlight_mark — クリックされた印（HIGHLIGHT_MARK_TEXT）を円の上に描く。窓の上にはみ出すなら円の下に描く
    #   （begin_drawing と end_drawing の間、円を描いた後に呼ぶ）
    #   screen_width, screen_height: 窓の幅・高さ [pixel]
    #   ⚠ 仮の印。後で別の強調表示に置き換える
    # 例: species.draw_highlight_mark(rl.get_screen_width(), rl.get_screen_height())
    fn draw_highlight_mark(let self, let screen_width: int, let screen_height: int) -> None:
        let center = self.get_screen_center(screen_width, screen_height)
        let mark_top = highlight_mark_top(center.y, self.get_radius())
        draw_centered_text(HIGHLIGHT_MARK_TEXT, center.x, mark_top, HIGHLIGHT_MARK_FONT_SIZE, HIGHLIGHT_MARK_COLOR)

    # is_quantity_fixed — 量が反応で変わらない化学種か（外から無限に供給・拡散されて一定に保たれる）
    #   戻り値: 既定は False。Solute は is_const を返す
    # 例: proton.is_quantity_fixed()   # proton が Solute(is_const = True) なら True
    fn is_quantity_fixed(let self) -> bool:
        return False

    # change_quantity — 量を amount だけ増減させる（反応の時間発展で kinetics.advance が呼ぶ）
    #   amount: 量の変化（負なら減る）。⚠ self を書き換える
    #   is_quantity_fixed() が True の化学種では何もしない（無限の供給・拡散で量が一定に保たれる）
    # 例: species_list[0].change_quantity(-0.1)
    fn change_quantity(mut self, let amount: float) -> None:
        if not self.is_quantity_fixed():
            self.quantity += amount

    protected:
    mut quantity: float
    mut pos: Position
    let color: rl.Color

class Adsorbate(Species):
    pass

class Solute(Species):
    public:
    let is_const: bool

    # is_quantity_fixed — is_const が True なら、外から無限に供給・拡散されて量は一定（反応で変わらない）
    #   戻り値: is_const
    # 例: proton.is_quantity_fixed()   # True
    fn is_quantity_fixed(let self) -> bool:
        return self.is_const

# Stoichiometry — 反応式の 1 項（化学種と、その係数）
#   メンバー:
#     species: Species（public）— 化学種。⚠ 作ったときの写しなので、量は更新されない。反応では名前（species.name）で
#              化学種を指し、量は kinetics.advance に渡す化学種の並びから読む
#     ratio: int（public・不変）— 化学量論係数（1 以上）
# 例: cg.Stoichiometry(proton, 1)
class Stoichiometry:
    public:
    mut species: Species
    let ratio: int

new_type Fn_RateCoefficient: function[let Reaction, let env.Potential]->float

# check_stoichiometry — 反応式の片側の項がすべて係数 1 以上か確かめる（Reaction の __init__ が呼ぶ）
#   entries:   反応式の片側の項
#   side_name: エラーメッセージに出す側の名前（"node_A" など）
#   係数が 1 未満の項があれば ValueError
# 例: check_stoichiometry([Stoichiometry(proton, 1)], "node_A")
fn check_stoichiometry(let entries: list[Stoichiometry], let side_name: str) -> None:
    for entry in entries:
        if entry.ratio < 1:
            raise ValueError(side_name + ": the ratio of '" + entry.species.name + "' is " + str(entry.ratio) + "; it must be 1 or more")

# log_scaled — 正の値の log10 を [lower_value, upper_value] から [lower_output, upper_output] へ線形に写す（範囲の外は端の値）
#   value: 写す値（速度定数・反応速度など）。0 以下は lower_output（log が −∞）。NaN なら ValueError
#   lower_value, upper_value: 写す範囲（0 < lower_value < upper_value）
#   lower_output, upper_output: 範囲の端に対応する出力
#   戻り値: lower_output + (upper_output - lower_output) × (log10 value - log10 lower_value) / (log10 upper_value - log10 lower_value)
#           value ≤ lower_value なら lower_output、value ≥ upper_value なら upper_output
# 例: log_scaled(100.0, 1.0e-2, 1.0e6, 5.0, 20.0)   # 12.5（log10 が範囲 -2〜6 のちょうど中央）
fn log_scaled(let value: float, let lower_value: float, let upper_value: float, let lower_output: float, let upper_output: float) -> float:
    if value != value:
        raise ValueError("value is NaN; it cannot be scaled")
    if value <= lower_value:
        return lower_output
    if value >= upper_value:
        return upper_output
    let fraction = (log10(value) - log10(lower_value)) / (log10(upper_value) - log10(lower_value))
    return lower_output + (upper_output - lower_output) * fraction

# reaction_flow_speed — 速度定数から、矢印のグラデーションが流れる速さを決める
#   rate_constant: 正反応の速度定数（今の電位での値）
#   戻り値: [周期/画面の秒]。速度定数 1e-2 以下で 0.5、1e6 以上で 4.5、その間は log10 に比例
# 例: reaction_flow_speed(100.0)   # 2.5
fn reaction_flow_speed(let rate_constant: float) -> float:
    return log_scaled(rate_constant, SCALE_LOWER_VALUE, SCALE_UPPER_VALUE, MINIMUM_FLOW_CYCLES_PER_SECOND, MAXIMUM_FLOW_CYCLES_PER_SECOND)

# reaction_arrow_thickness — 反応速度（速度定数 × 基質の量の積）から、矢印の太さを決める
#   rate: 正反応の速度 k_f Π q^ν（kinetics.forward_reaction_rate の値）
#   戻り値: [pixel]。速度 1e-2 以下（0 も）で 5、1e6 以上で 20、その間は log10 に比例
# 例: reaction_arrow_thickness(100.0)   # 12.5
fn reaction_arrow_thickness(let rate: float) -> float:
    return log_scaled(rate, SCALE_LOWER_VALUE, SCALE_UPPER_VALUE, MINIMUM_ARROW_THICKNESS, MAXIMUM_ARROW_THICKNESS)

# edge_point_toward — 円の中心から target へ向かう向きの、円周上の点を返す（矢印を円の縁から出す・縁で止めるため）
#   circle_center: 円の中心 [pixel]
#   radius: 円の半径 [pixel]
#   target: 向かう先の点 [pixel]
#   戻り値: circle_center + radius × (target - circle_center) / |target - circle_center|。target が中心と同じなら中心
# 例: edge_point_toward(rl.Vector2(100.0, 100.0), 50.0, rl.Vector2(300.0, 100.0))   # rl.Vector2(150.0, 100.0)
fn edge_point_toward(let circle_center: rl.Vector2, let radius: float, let target: rl.Vector2) -> rl.Vector2:
    let offset_x = target.x - circle_center.x
    let offset_y = target.y - circle_center.y
    let distance = (offset_x * offset_x + offset_y * offset_y) ** 0.5
    if distance == 0.0:
        return circle_center
    return rl.Vector2(circle_center.x + radius * offset_x / distance, circle_center.y + radius * offset_y / distance)

# distance_between — 2 点の距離を返す
#   first, second: 点 [pixel]
#   戻り値: 距離 [pixel]
# 例: distance_between(rl.Vector2(0.0, 0.0), rl.Vector2(3.0, 4.0))   # 5.0
fn distance_between(let first: rl.Vector2, let second: rl.Vector2) -> float:
    let offset_x = second.x - first.x
    let offset_y = second.y - first.y
    return (offset_x * offset_x + offset_y * offset_y) ** 0.5

# draw_reaction_segment — 反応の矢印の 1 本（基質 → 中心、または中心 → 生成物）を、緩やかな円弧で描く
#   start, end: 始点・終点 [pixel]
#   thickness: 太さ [pixel]
#   flow_phase: グラデーションの位相 [周期]（小数部だけが効く）
#   has_head: True なら終点に矢じりを描く（中心 → 生成物）、False なら矢じりなし（基質 → 中心）
#   曲率は REACTION_ARROW_BEND / 弦の長さ（正なので、進む向きに見て左へ曲がる）。始点と終点が同じなら何も描かない
# 例: draw_reaction_segment(rl.Vector2(100.0, 300.0), rl.Vector2(300.0, 300.0), 8.0, 0.25, True)
fn draw_reaction_segment(let start: rl.Vector2, let end: rl.Vector2, let thickness: float, let flow_phase: float, let has_head: bool) -> None:
    let chord_length = distance_between(start, end)
    if chord_length == 0.0:
        return
    let curvature = REACTION_ARROW_BEND / chord_length
    if has_head:
        rl.draw_curved_arrow_flowing(start.x, start.y, end.x, end.y, thickness, REACTION_ARROW_START_COLOR, REACTION_ARROW_MIDDLE_COLOR, REACTION_ARROW_END_COLOR, curvature, flow_phase)
    else:
        rl.draw_curved_line_flowing(start.x, start.y, end.x, end.y, thickness, REACTION_ARROW_START_COLOR, REACTION_ARROW_MIDDLE_COLOR, REACTION_ARROW_END_COLOR, curvature, flow_phase)

# find_species_by_name — 化学種の並びから名前で化学種を探す（反応が名前で指す化学種の、今の量・位置を読むため）
#   species_list: 化学種の並び
#   species_name: 名前
#   戻り値: 最初に見つかった化学種。無ければ ValueError
# 例: find_species_by_name(species_pool, "H_ads").get_radius()
fn find_species_by_name(let species_list: list[Species], let species_name: str) -> Species:
    for species in species_list:
        if species.name == species_name:
            return species
    raise ValueError("species '" + species_name + "' is not in the species list")

# Reaction — 化学種（node_A の側）と化学種（node_B の側）をつなぐ反応。node_A → node_B を正反応とする
#   メンバー:
#     node_A: list[Stoichiometry]（public）— 正反応の反応物（左辺）
#     node_B: list[Stoichiometry]（public）— 正反応の生成物（右辺）
#     fw_rate_coefficient: Fn_RateCoefficient（public・不変）— 正反応の速度定数を返す関数（kinetics で作る）
#     bw_rate_coefficient: Fn_RateCoefficient（public・不変）— 逆反応の速度定数を返す関数
#     is_reversible: bool（public・不変）— False なら逆反応を起こさない
#     pos: Position（private・不変）— 反応の中心の位置（窓の大きさに対する割合）。基質と生成物を結ぶ矢印がここを通る
#     forward_rate_coefficient(potential) -> float / backward_rate_coefficient(potential) -> float — その電位での速度定数
#     net_stoichiometry(species_name) -> int — 正反応が 1 回進んだときの、その化学種の数の変化（右辺の係数 - 左辺の係数）
#     species_names() -> list[str] — 反応に出てくる化学種の名前（重複なし・左辺から順）
#     draw(species_list, rate, flow_phase, is_backward, screen_width, screen_height) -> None — 速いほうの向きに、
#         出発側 → 中心 → 行き先の矢印を描く（is_backward が True なら生成物 → 基質）
#     draw_through_center(...)（private）— draw の本体（出発側・行き先の項を受け取って描く）
#   反応の速さ（質量作用）と量の時間発展は kinetics にある。化学種は名前で指す（Stoichiometry の注意を参照）
# 例: let volmer = Reaction([Stoichiometry(proton, 1), Stoichiometry(vacancy, 1)], [Stoichiometry(H_ads, 1)], fw, bw, Position(0.3, 0.5))
class Reaction:
    public:
    mut node_A: list[Stoichiometry]
    mut node_B: list[Stoichiometry]

    let fw_rate_coefficient: Fn_RateCoefficient
    let bw_rate_coefficient: Fn_RateCoefficient

    let is_reversible: bool

    # __init__ — 反応を作る。係数が 1 未満の項があれば ValueError
    #   node_A, node_B: 正反応の左辺・右辺
    #   fw_rate_coefficient, bw_rate_coefficient: 正・逆反応の速度定数の関数（kinetics.butler_volmer_k_pair などで作る）
    #   pos: 反応の中心の位置（窓の大きさに対する割合）
    #   is_reversible: False なら逆反応を起こさない（backward_rate_coefficient が 0）
    fn __init__(
        mut self,
        let node_A: list[Stoichiometry],
        let node_B: list[Stoichiometry],
        let fw_rate_coefficient: Fn_RateCoefficient,
        let bw_rate_coefficient: Fn_RateCoefficient,
        let pos: Position,
        let is_reversible: bool = True
        )->Self:

        check_stoichiometry(node_A, "node_A")
        check_stoichiometry(node_B, "node_B")
        self.node_A = node_A
        self.node_B = node_B

        self.fw_rate_coefficient = fw_rate_coefficient
        self.bw_rate_coefficient = bw_rate_coefficient

        self.pos = pos
        self.is_reversible = is_reversible
        return self

    # draw — 反応を矢印で描く。速いほうの向きに、出発側の円の縁 → 反応の中心（矢じりなし）、中心 → 行き先の円の縁（矢じりあり）
    #   （begin_drawing と end_drawing の間、化学種の円より先に呼ぶ）
    #   species_list: 化学種の並び（今の量・位置を名前で読む。反応の化学種が無ければ ValueError）
    #   rate: 描く向きの反応の速さ（kinetics.forward_reaction_rate / backward_reaction_rate の大きいほう）。太さを決める
    #         （reaction_arrow_thickness）
    #   flow_phase: グラデーションの位相 [周期]（呼ぶ側が reaction_flow_speed × 画面の経過時間 を積み上げる）
    #   is_backward: False なら基質（node_A）→ 生成物（node_B）、True なら逆向き（逆反応のほうが速いとき）
    #   screen_width, screen_height: 窓の幅・高さ [pixel]
    #   中心が化学種の円の中に入っている矢印は描かない（向きが決まらない）。中心には点を描く
    # 例: volmer.draw(species_pool, 3.2, flow_phase, False, rl.get_screen_width(), rl.get_screen_height())
    fn draw(let self, let species_list: list[Species], let rate: float, let flow_phase: float, let is_backward: bool, let screen_width: int, let screen_height: int) -> None:
        let thickness = reaction_arrow_thickness(rate)
        if is_backward:
            self.draw_through_center(species_list, self.node_B, self.node_A, thickness, flow_phase, screen_width, screen_height)
        else:
            self.draw_through_center(species_list, self.node_A, self.node_B, thickness, flow_phase, screen_width, screen_height)
        let center = self.pos.to_screen(screen_width, screen_height)
        rl.draw_filled_circle(center.x, center.y, max(REACTION_CENTER_RADIUS, thickness / 2.0), REACTION_CENTER_COLOR)

    private:
    let pos: Position

    # draw_through_center — sources の各化学種の円の縁 → 反応の中心（矢じりなし）、中心 → targets の各化学種の円の縁（矢じりあり）を描く
    #   species_list: 化学種の並び（今の量・位置を名前で読む）
    #   sources, targets: 出発側・行き先の反応式の項（draw が向きに応じて node_A / node_B を渡す）
    #   thickness: 太さ [pixel]
    #   flow_phase: グラデーションの位相 [周期]
    #   screen_width, screen_height: 窓の幅・高さ [pixel]
    # 例: self.draw_through_center(species_list, self.node_A, self.node_B, 8.0, 0.25, 1100, 700)
    fn draw_through_center(let self, let species_list: list[Species], let sources: list[Stoichiometry], let targets: list[Stoichiometry], let thickness: float, let flow_phase: float, let screen_width: int, let screen_height: int) -> None:
        let center = self.pos.to_screen(screen_width, screen_height)
        for entry in sources:
            let source = find_species_by_name(species_list, entry.species.name)
            let source_center = source.get_screen_center(screen_width, screen_height)
            if distance_between(source_center, center) > source.get_radius():
                draw_reaction_segment(edge_point_toward(source_center, source.get_radius(), center), center, thickness, flow_phase, False)
        for entry in targets:
            let target = find_species_by_name(species_list, entry.species.name)
            let target_center = target.get_screen_center(screen_width, screen_height)
            if distance_between(target_center, center) > target.get_radius():
                draw_reaction_segment(center, edge_point_toward(target_center, target.get_radius(), center), thickness, flow_phase, True)

    public:

    # forward_rate_coefficient — 電位 potential での正反応の速度定数を返す
    #   potential: 電極の電位（main.ar が決めた値を渡す）
    #   戻り値: fw_rate_coefficient(self, potential)
    # 例: volmer.forward_rate_coefficient(env.Potential(-0.1))
    fn forward_rate_coefficient(let self, let potential: env.Potential) -> float:
        let coefficient_function = self.fw_rate_coefficient => function[let Reaction, let env.Potential]->float
        return coefficient_function(self, potential)

    # backward_rate_coefficient — 電位 potential での逆反応の速度定数を返す
    #   potential: 電極の電位
    #   戻り値: bw_rate_coefficient(self, potential)。is_reversible が False なら 0.0
    # 例: volmer.backward_rate_coefficient(env.Potential(-0.1))
    fn backward_rate_coefficient(let self, let potential: env.Potential) -> float:
        if not self.is_reversible:
            return 0.0
        let coefficient_function = self.bw_rate_coefficient => function[let Reaction, let env.Potential]->float
        return coefficient_function(self, potential)

    # net_stoichiometry — 正反応が 1 回進んだときの、化学種 species_name の数の変化を返す
    #   species_name: 化学種の名前
    #   戻り値: 右辺（node_B）の係数の和 - 左辺（node_A）の係数の和。出てこなければ 0
    # 例: volmer.net_stoichiometry("H_ads")   # 1（H+ + * → H_ads）
    #     volmer.net_stoichiometry("vacancy") # -1
    fn net_stoichiometry(let self, let species_name: str) -> int:
        mut change = 0
        for entry in self.node_B:
            if entry.species.name == species_name:
                change += entry.ratio
        for entry in self.node_A:
            if entry.species.name == species_name:
                change -= entry.ratio
        return change

    # species_names — 反応に出てくる化学種の名前を返す（重複なし・左辺、右辺の順）
    #   戻り値: 名前の並び
    # 例: volmer.species_names()   # ["H+", "vacancy", "H_ads"]
    fn species_names(let self) -> list[str]:
        mut names: list[str] = []
        for entry in self.node_A + self.node_B:
            if entry.species.name not in names:
                names.append(entry.species.name)
        return names


# ---- 化学種の並びを描く・クリックされた化学種を探す ----

# find_species_at — 窓の中の点に重なる化学種のうち、最も手前のものの番号を返す
#   species_list: 描く順に並べた化学種（後ろほど手前に描かれる。draw_species_list に渡すものと同じ並び）
#   point: 確かめる点 [pixel]（rl.get_mouse_position() の値）
#   screen_width, screen_height: 窓の幅・高さ [pixel]
#   戻り値: 重なる化学種のうち最も後ろの番号。どれにも重ならなければ None
# 例: let clicked_index = find_species_at([vacancy, H_ads], rl.Vector2(400.0, 300.0), 800, 600)
fn find_species_at(let species_list: list[Species], let point: rl.Vector2, let screen_width: int, let screen_height: int) -> Option[int]:
    mut index = len(species_list) - 1
    while index >= 0:
        if species_list[index].contains_screen_point(point, screen_width, screen_height):
            return index
        index -= 1
    return None

# draw_species_list — 化学種を並びの順に円で描き（後ろほど手前）、highlighted_index の化学種にクリックされた印を描く
#   （begin_drawing と end_drawing の間で呼ぶ）
#   species_list: 描く順に並べた化学種
#   highlighted_index: 印を描く化学種の番号（find_species_at の戻り値）。None なら印を描かない。範囲外なら IndexError
#   screen_width, screen_height: 窓の幅・高さ [pixel]
#   印はすべての円の後に描くので、後ろの円に隠れない。
# 例: draw_species_list([vacancy, H_ads], 1, rl.get_screen_width(), rl.get_screen_height())
fn draw_species_list(let species_list: list[Species], let highlighted_index: Option[int], let screen_width: int, let screen_height: int) -> None:
    for species in species_list:
        species.draw(screen_width, screen_height)
    if highlighted_index is not None:
        species_list[highlighted_index].draw_highlight_mark(screen_width, screen_height)
