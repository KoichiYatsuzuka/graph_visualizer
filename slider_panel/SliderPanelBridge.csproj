<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SliderPanelBridge — Arrow の import[cs-dll] から使う、スライダーを並べた WinForms の窓。
    build.ps1 が 2 回ビルドする:
      1 回目: dotnet build で ArrowGenerated=false（ArrowExports.g.cs を外したマネージド DLL）
              → arrow の gen-cs-exports がそのメタデータから ArrowExports.g.cs（Arrow が呼ぶ export）を作る
      2 回目: dotnet publish（NativeAOT。生成した export を含む）→ SliderPanelBridge_native.dll
    1 回目に外すのは、古い ArrowExports.g.cs が消えたメソッドを呼んでいてもビルドが通るようにするため。
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- 生成した export は using を自分で書く。WinForms の暗黙の using（System.Drawing など）と名前がぶつからないよう切る -->
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <!-- InvariantGlobalization は付けない: WinForms がアセンブリ名のカルチャ（zh-Hans など）を読むと CultureNotFoundException で落ちる -->
    <AssemblyName>SliderPanelBridge</AssemblyName>
    <RootNamespace>SliderPanelBridge</RootNamespace>
  </PropertyGroup>
  <ItemGroup Condition="'$(ArrowGenerated)' == 'false'">
    <Compile Remove="ArrowExports.g.cs" />
  </ItemGroup>
  <!--
    生成した ArrowExports.g.cs は、配列を受け渡すメソッドが無くても ArrowInterop.ArPtrProtocol を参照する。
    その定義（ArPtrProtocol.cs）は Arrow の配布物に入っていないので、Arrow のソース（test_lang）のものを写さずに参照する。
    build.ps1 が ArPtrProtocolSource を渡す（既定はこのリポジトリと並んだ test_lang/bridge/ptr_protocol/ArPtrProtocol.cs）。
  -->
  <ItemGroup Condition="'$(ArPtrProtocolSource)' != ''">
    <Compile Include="$(ArPtrProtocolSource)" Link="ArPtrProtocol.cs" />
  </ItemGroup>
</Project>
