# test_chemical_graphs.ar — chemical_graphs の化学種を円として描く機能（大きさ・クリックの判定・描画・印）を確かめる自動テスト
#
# 実行: arrow tests/test_chemical_graphs.ar（tests/run_tests.ps1 が tests/test_*.ar をまとめて走らせる）
# 前提: raylib_bridge/install_raylib.ps1 → raylib_bridge/build.ps1 で raylib_bridge.dll を作ってあること。
#
# 見ること:
#   1. 半径: quantity 1 で 100、1/10 ごとに半分（0.1 → 50・0.01 → 25・0.001 → 12.5）、下限 10（0 以下も 10）、
#      1 より大きい量は 100 より大きい。NaN・正の無限大は ValueError
#   2. 位置: Position（窓に対する割合）を窓のピクセルに換算できる
#   3. クリックの判定: 円の中・外、重なった円では最も手前（並びの後ろ）の化学種、どれにも重ならなければ None
#   4. 文字の色・印の位置: 明るい塗りには濃い文字、暗い塗りには白い文字、円からはみ出す行は背景に合わせる。
#      印は円の上、窓の上にはみ出すなら円の下
#   5. 描画（非表示の窓で画素を読み戻す）: 円の色・名前と量の文字・クリックされた印（印を付けた化学種にだけ・None なら無し）、
#      範囲外の番号は IndexError
#   6. 反応の矢印: 速度定数 → 流れる速さ（0.5〜4.5 周期/秒）・反応速度 → 太さ（5〜20 px）が log10 で 1e-2〜1e6 の間だけ変わる、
#      円の縁の点、基質 → 中心は矢じりなし・中心 → 生成物は矢じりあり・緩やかに曲がる・中心の点、反応の化学種が無ければ ValueError、
#      is_backward なら向きが逆（生成物 → 中心 → 基質。矢じりは基質の手前）
#   7. ばね: 質量は半径に比例・反応の中心は量 0.5 と同じ重さ・ばねの力の向きと大きさ・1 フレームの速度と位置・
#      運動量の和は 0・長いフレームは頭打ち・減衰してばねと反発のつり合いに落ち着く・化学種が無ければ ValueError
#      反発: -2 乗と -6 乗の項の和（遠いと -2 乗、近いと -6 乗が主）・頭打ち・向き・つながっていない 2 つは離れ、
#      軽いほうが質量の比だけ速い
# 期待と違えば RuntimeError を raise して非 0 で終わる。

# ⚠ rl は cg より先に import する。raylib_bridge を import するモジュール（cg）を先に import すると、このファイルで構造体を
#   返す関数（read_screen_pixel など）を呼んだところで NameError: 'Color' is not defined になる（Arrow 0.7.2・2026-11-26 実測）
import[cpp-dll] ..raylib_bridge.raylib_bridge as rl
import ..raylib_bridge.raylib_consts as rlc
import ..chemical_graphs as cg
import ..environment as env
import ..spectrum as spc

const WINDOW_WIDTH = 800
const WINDOW_HEIGHT = 600
const FRAME_COUNT = 3                 # 最後のフレームで画素を確かめる
const RADIUS_TOLERANCE = 1e-9         # 半径の浮動小数点の誤差の許容 [pixel]

let BACKGROUND_COLOR = cg.CANVAS_BACKGROUND_COLOR    # 円からはみ出す文字の色はこの背景に合わせて選ばれる
let BLUE_COLOR = rl.Color(0, 121, 241, 255)       # 暗い塗り（白い文字）
let ORANGE_COLOR = rl.Color(255, 161, 0, 255)     # 明るい塗り（濃い文字）

# ---- 描画の確認に使う場面（窓 800 x 600）----
# 青い Solute "H2":   quantity 1.0  → 半径 100、中心 (200, 300)
# 橙の Adsorbate "H_ads": quantity 0.01 → 半径 25、中心 (600, 300)（名前は円からはみ出す）
# 青い Adsorbate "vacancy": quantity 0.0 → 半径 10（下限）、中心 (400, 90)（名前は明るい背景へはみ出す）
const SCENE_NAME_ROW = 291            # 名前の行の中ほどの y（上端 300 - (20 + 2 + 16) // 2 = 281 に 20 // 2 を足す）
const SCENE_BLUE_MARK_ROW = 186       # 青い円の印の行の中ほどの y（上端 300 - 100 - 4 - 20 = 176 に 20 // 2 を足す）
const SCENE_ORANGE_MARK_ROW = 261     # 橙の円に印を描いたときの行の中ほどの y（上端 300 - 25 - 4 - 20 = 251 に 10 を足す）
const SCENE_VACANCY_NAME_ROW = 81     # vacancy の名前の行の中ほどの y（上端 90 - 19 = 71 に 10 を足す）

# constant_rate_coefficient — 反応を作るための仮の速度定数の関数（描画のテストでは速度定数を使わない）
#   reaction: 反応（使わない）
#   potential: 電位（使わない）
#   戻り値: 1.0
# 例: cg.Fn_RateCoefficient(constant_rate_coefficient)
fn constant_rate_coefficient(let reaction: cg.Reaction, let potential: env.Potential) -> float:
    return 1.0

# expect_true — 条件が偽なら RuntimeError を投げ、真なら OK を表示する
#   condition: 確かめる条件
#   label:     表示とエラーメッセージに出す説明
# 例: expect_true(cg.radius_for_quantity(1.0) == 100.0, "radius at quantity 1")
fn expect_true(let condition: bool, let label: str) -> None:
    if not condition:
        raise RuntimeError("FAILED: " + label)
    print("OK:", label)

# expect_close — 2 つの float の差が tolerance 以下か確かめる
#   actual, expected: 比べる値
#   tolerance: 許容する差
#   label: 表示とエラーメッセージに出す説明
# 例: expect_close(cg.radius_for_quantity(0.1), 50.0, RADIUS_TOLERANCE, "radius at quantity 0.1")
fn expect_close(let actual: float, let expected: float, let tolerance: float, let label: str) -> None:
    expect_true(abs(actual - expected) <= tolerance, label + ": " + str(actual) + " (expected " + str(expected) + ")")

# radius_raises_value_error — radius_for_quantity が ValueError を投げれば True を返す
#   quantity: 渡す量
#   戻り値: ValueError なら True、値が返れば False
# 例: radius_raises_value_error(float("nan")) == True
fn radius_raises_value_error(let quantity: float) -> bool:
    try:
        let _ = cg.radius_for_quantity(quantity)
    except ValueError:
        return True
    return False

# found_index_is — find_species_at の戻り値が expected の番号か（Option[int] は int と直接 == で比べられない）
#   found:    find_species_at の戻り値
#   expected: 期待する番号
#   戻り値: found が None でなく expected と等しければ True
# 例: found_index_is(cg.find_species_at(species_list, point, 800, 600), 1)
fn found_index_is(let found: Option[int], let expected: int) -> bool:
    if found is not None:
        return found == expected
    return False

# same_rgb — 2 つの色の r, g, b が等しいか（read_screen_pixel のアルファは常に 255 なので比べない）
#   actual, expected: 比べる色
#   戻り値: r, g, b がすべて等しければ True
# 例: same_rgb(rl.Color(1, 2, 3, 255), rl.Color(1, 2, 3, 0)) == True
fn same_rgb(let actual: rl.Color, let expected: rl.Color) -> bool:
    return actual.r == expected.r and actual.g == expected.g and actual.b == expected.b

# expect_pixel — 今のフレームの画素 (x, y) が期待の色か確かめる（begin_drawing と end_drawing の間で呼ぶ）
#   x, y:     画素の位置（ウィンドウの左上が (0, 0)）
#   expected: 期待する色
#   label:    表示とエラーメッセージに出す説明
# 例: expect_pixel(270, 300, BLUE_COLOR, "inside the blue circle")
fn expect_pixel(let x: int, let y: int, let expected: rl.Color, let label: str) -> None:
    let actual = rl.read_screen_pixel(x, y) mustbe rl.Color
    let color_text = str(actual.r) + "," + str(actual.g) + "," + str(actual.b)
    expect_true(same_rgb(actual, expected), label + ": pixel (" + str(x) + ", " + str(y) + ") is " + color_text)

# count_pixels_like — 横 1 行の区間 [x_start, x_end) で、色が target から各チャンネル tolerance 以内の画素を数える
#   y:              行の位置
#   x_start, x_end: 数える区間（x_end は含まない）
#   target:         探す色（文字の色など）
#   tolerance:      各チャンネルの許容差（文字の縁のにじみを含めるため）
#   戻り値: 当てはまる画素の数
# 例: count_pixels_like(SCENE_NAME_ROW, 170, 230, cg.LIGHT_LABEL_COLOR, 60)   # 青い円の中の白い名前の画素
fn count_pixels_like(let y: int, let x_start: int, let x_end: int, let target: rl.Color, let tolerance: int) -> int:
    mut matched_count = 0
    mut x = x_start
    while x < x_end:
        let pixel = rl.read_screen_pixel(x, y) mustbe rl.Color
        let channel_gap = max(abs(pixel.r - target.r), abs(pixel.g - target.g), abs(pixel.b - target.b))
        if channel_gap <= tolerance:
            matched_count += 1
        x += 1
    return matched_count

# scene_species — 描画の確認に使う化学種の並び（青い Solute "H2"、橙の Adsorbate "H_ads"、青い Adsorbate "vacancy"。後ろほど手前）
#   戻り値: [H2, H_ads, vacancy]
# 例: cg.draw_species_list(scene_species(), 0, WINDOW_WIDTH, WINDOW_HEIGHT)
fn scene_species() -> list[cg.Species]:
    let h2 = cg.Solute(name = "H2", pos = cg.Position(0.25, 0.5), quantity = 1.0, color = BLUE_COLOR, is_const = True)
    let h_ads = cg.Adsorbate(name = "H_ads", pos = cg.Position(0.75, 0.5), quantity = 0.01, color = ORANGE_COLOR)
    let vacancy = cg.Adsorbate(name = "vacancy", pos = cg.Position(0.5, 0.15), quantity = 0.0, color = BLUE_COLOR)
    let scene: list[cg.Species] = [h2, h_ads, vacancy]
    return scene

# check_radius — 1. 量から半径を決める規則を確かめる
# 例: check_radius()
fn check_radius() -> None:
    expect_close(cg.radius_for_quantity(1.0), 100.0, RADIUS_TOLERANCE, "radius at quantity 1 is 100")
    expect_close(cg.radius_for_quantity(0.1), 50.0, RADIUS_TOLERANCE, "radius at quantity 0.1 is 50")
    expect_close(cg.radius_for_quantity(0.01), 25.0, RADIUS_TOLERANCE, "radius at quantity 0.01 is 25")
    expect_close(cg.radius_for_quantity(0.001), 12.5, RADIUS_TOLERANCE, "radius at quantity 0.001 is 12.5")
    expect_close(cg.radius_for_quantity(0.05), cg.radius_for_quantity(0.5) / 2.0, RADIUS_TOLERANCE, "radius halves when quantity becomes 1/10 (0.5 -> 0.05)")
    expect_true(cg.radius_for_quantity(0.0001) == 10.0, "radius at quantity 0.0001 (6.25) is raised to the minimum 10")
    expect_true(cg.radius_for_quantity(0.0) == 10.0, "radius at quantity 0 is the minimum 10")
    expect_true(cg.radius_for_quantity(-0.5) == 10.0, "radius at a negative quantity is the minimum 10")
    expect_close(cg.radius_for_quantity(10.0), 200.0, RADIUS_TOLERANCE, "radius at quantity 10 is 200 (no upper limit)")
    expect_true(radius_raises_value_error(float("nan")), "radius at quantity NaN is ValueError")
    expect_true(radius_raises_value_error(float("inf")), "radius at quantity +inf is ValueError")

# check_position — 2. 窓に対する割合の位置を窓のピクセルに換算できることを確かめる
# 例: check_position()
fn check_position() -> None:
    let point = cg.Position(0.1, 0.9).to_screen(WINDOW_WIDTH, WINDOW_HEIGHT)
    expect_true(point.x == 80.0 and point.y == 540.0, "Position(0.1, 0.9) is (80, 540) in an 800 x 600 window")

# check_hit_test — 3. クリックした点が円に重なるかの判定と、最も手前の化学種の選び方を確かめる
# 例: check_hit_test()
fn check_hit_test() -> None:
    # 半径 50（quantity 0.1）、中心 (400, 300)
    let medium = cg.Adsorbate(name = "medium", pos = cg.Position(0.5, 0.5), quantity = 0.1, color = ORANGE_COLOR)
    expect_true(medium.get_quantity() == 0.1, "get_quantity still returns the quantity")
    expect_true(same_rgb(medium.get_color(), ORANGE_COLOR) and medium.get_color().a == ORANGE_COLOR.a, "get_color returns the fill color given at init")
    expect_true(len(medium.get_peak_set().peak_list) == 0, "an Adsorbate made without peak_set has no peaks")
    let band = spc.Absorption(spc.Wavelength(450.0), spc.Absorbance(0.8), spc.Wavelength(50.0))
    let absorbing = cg.Adsorbate(name = "absorbing", pos = cg.Position(0.5, 0.5), quantity = 0.1, color = ORANGE_COLOR, peak_set = spc.PeakSet([band]))
    expect_true(len(absorbing.get_peak_set().peak_list) == 1 and (absorbing.get_peak_set().peak_list[0].center => float) == 450.0, "get_peak_set returns the PeakSet given at init")
    let solute = cg.Solute(name = "solute", pos = cg.Position(0.5, 0.5), quantity = 1.0, color = ORANGE_COLOR, is_const = True)
    expect_true(len(solute.get_peak_set().peak_list) == 0, "a Solute has no peaks (the Species default)")
    expect_true(medium.contains_screen_point(rl.Vector2(400.0, 300.0), WINDOW_WIDTH, WINDOW_HEIGHT), "the center is inside")
    expect_true(medium.contains_screen_point(rl.Vector2(449.0, 300.0), WINDOW_WIDTH, WINDOW_HEIGHT), "49 px to the right of the center is inside (radius 50)")
    expect_true(medium.contains_screen_point(rl.Vector2(435.0, 335.0), WINDOW_WIDTH, WINDOW_HEIGHT), "49.5 px diagonally is inside")
    expect_true(not medium.contains_screen_point(rl.Vector2(451.0, 300.0), WINDOW_WIDTH, WINDOW_HEIGHT), "51 px to the right of the center is outside")
    expect_true(not medium.contains_screen_point(rl.Vector2(436.0, 336.0), WINDOW_WIDTH, WINDOW_HEIGHT), "50.9 px diagonally is outside")

    # 大きい円（半径 100・中心 (400, 300)）の上に、小さい円（半径 12.5・中心 (440, 300)）が重なる
    let large = cg.Solute(name = "large", pos = cg.Position(0.5, 0.5), quantity = 1.0, color = BLUE_COLOR, is_const = True)
    let small = cg.Adsorbate(name = "small", pos = cg.Position(0.55, 0.5), quantity = 0.001, color = ORANGE_COLOR)
    let small_in_front: list[cg.Species] = [large, small]
    let large_in_front: list[cg.Species] = [small, large]
    let empty_list: list[cg.Species] = []
    let overlap_point = rl.Vector2(440.0, 300.0)
    expect_true(found_index_is(cg.find_species_at(small_in_front, overlap_point, WINDOW_WIDTH, WINDOW_HEIGHT), 1), "a point on both circles picks the front one (last in the list)")
    expect_true(found_index_is(cg.find_species_at(large_in_front, overlap_point, WINDOW_WIDTH, WINDOW_HEIGHT), 1), "the front one follows the list order")
    expect_true(found_index_is(cg.find_species_at(small_in_front, rl.Vector2(330.0, 300.0), WINDOW_WIDTH, WINDOW_HEIGHT), 0), "a point only on the large circle picks it")
    expect_true(cg.find_species_at(small_in_front, rl.Vector2(10.0, 10.0), WINDOW_WIDTH, WINDOW_HEIGHT) is None, "a point on no circle gives None")
    expect_true(cg.find_species_at(empty_list, overlap_point, WINDOW_WIDTH, WINDOW_HEIGHT) is None, "an empty list gives None")

# check_label_color_and_mark_position — 4. 文字の色の選び方と、印の行の位置を確かめる（measure_text を使うので init_window の後に呼ぶ）
# 例: check_label_color_and_mark_position()
fn check_label_color_and_mark_position() -> None:
    expect_true(same_rgb(cg.label_color_on(ORANGE_COLOR), cg.DARK_LABEL_COLOR), "a bright fill (orange) gets dark text")
    expect_true(same_rgb(cg.label_color_on(BLUE_COLOR), cg.LIGHT_LABEL_COLOR), "a dark fill (blue) gets white text")
    expect_true(cg.highlight_mark_top(300.0, 100.0) == 176, "the mark sits above the circle (top 176)")
    expect_true(cg.highlight_mark_top(50.0, 100.0) == 154, "the mark goes below the circle when it would leave the window (top 154)")
    expect_true(same_rgb(cg.label_color_for_line("H2", 20, 100.0, BLUE_COLOR), cg.LIGHT_LABEL_COLOR), "a line inside a dark circle gets white text")
    expect_true(same_rgb(cg.label_color_for_line("vacancy", 20, 10.0, BLUE_COLOR), cg.DARK_LABEL_COLOR), "a line wider than the circle follows the light background (dark text)")

# check_drawn_scene — 5. scene_species を描いたフレームの画素を確かめる（draw_species_list の直後、end_drawing の前に呼ぶ）
#   highlighted_index: draw_species_list に渡した印の番号（0 = 青い H2 に印・None = 印なし）
# 例: check_drawn_scene(0)
fn check_drawn_scene(let highlighted_index: Option[int]) -> None:
    let case_text = " (highlighted_index " + str(highlighted_index) + ")"
    expect_pixel(270, 300, BLUE_COLOR, "the blue circle is filled with its color" + case_text)
    expect_pixel(200, 210, BLUE_COLOR, "the blue circle reaches 90 px above the center (radius 100)" + case_text)
    expect_pixel(305, 300, BACKGROUND_COLOR, "nothing is drawn 105 px right of the blue center" + case_text)
    expect_pixel(600, 278, ORANGE_COLOR, "the orange circle (radius 25) is filled above its label" + case_text)
    expect_pixel(628, 300, BACKGROUND_COLOR, "nothing is drawn 28 px right of the orange center" + case_text)
    expect_true(count_pixels_like(SCENE_NAME_ROW, 170, 230, cg.LIGHT_LABEL_COLOR, 60) > 0, "the name is drawn in white on the blue circle" + case_text)
    expect_true(count_pixels_like(SCENE_NAME_ROW, 560, 640, cg.DARK_LABEL_COLOR, 60) > 0, "the name is drawn in dark gray on the orange circle" + case_text)
    expect_true(count_pixels_like(SCENE_NAME_ROW + 20, 170, 230, cg.LIGHT_LABEL_COLOR, 60) > 0, "the quantity is drawn under the name" + case_text)
    expect_true(count_pixels_like(SCENE_VACANCY_NAME_ROW, 350, 450, cg.DARK_LABEL_COLOR, 60) > 0, "a name wider than a dark circle is drawn dark on the light background" + case_text)
    let blue_mark_count = count_pixels_like(SCENE_BLUE_MARK_ROW, 140, 260, cg.HIGHLIGHT_MARK_COLOR, 60)
    let orange_mark_count = count_pixels_like(SCENE_ORANGE_MARK_ROW, 540, 660, cg.HIGHLIGHT_MARK_COLOR, 60)
    if highlighted_index is None:
        expect_true(blue_mark_count == 0 and orange_mark_count == 0, "no mark is drawn" + case_text)
    else:
        expect_true(blue_mark_count > 0, "the mark is drawn above the highlighted circle" + case_text)
        expect_true(orange_mark_count == 0, "no mark above the other circle" + case_text)

# draw_scene_frames — scene_species を FRAME_COUNT フレーム描き、最後のフレームで check_drawn_scene を呼ぶ
#   highlighted_index: draw_species_list に渡す印の番号
# 例: draw_scene_frames(None)
fn draw_scene_frames(let highlighted_index: Option[int]) -> None:
    mut frame_index = 0
    while frame_index < FRAME_COUNT:
        rl.begin_drawing()
        rl.clear_background(BACKGROUND_COLOR)
        cg.draw_species_list(scene_species(), highlighted_index, WINDOW_WIDTH, WINDOW_HEIGHT)
        if frame_index == FRAME_COUNT - 1:
            check_drawn_scene(highlighted_index)
        rl.end_drawing()
        frame_index += 1

# check_index_out_of_range — draw_species_list に範囲外の番号を渡すと IndexError になることを確かめる
# 例: check_index_out_of_range()
fn check_index_out_of_range() -> None:
    mut raised_index_error = False
    rl.begin_drawing()
    rl.clear_background(BACKGROUND_COLOR)
    try:
        cg.draw_species_list(scene_species(), 3, WINDOW_WIDTH, WINDOW_HEIGHT)
    except IndexError:
        raised_index_error = True
    rl.end_drawing()
    expect_true(raised_index_error, "draw_species_list with highlighted_index out of range is IndexError")


# check_arrow_scaling — 6. 速さ・太さの写し方と、円の縁の点
# 例: check_arrow_scaling()
fn check_arrow_scaling() -> None:
    expect_close(cg.reaction_flow_speed(1.0e-3), 0.5, RADIUS_TOLERANCE, "flow speed below 1e-2 stays at 0.5 cycles/s")
    expect_close(cg.reaction_flow_speed(1.0e-2), 0.5, RADIUS_TOLERANCE, "flow speed at 1e-2 is 0.5")
    expect_close(cg.reaction_flow_speed(1.0e2), 2.5, RADIUS_TOLERANCE, "flow speed at 1e2 (middle of the log range) is 2.5")
    expect_close(cg.reaction_flow_speed(1.0e6), 4.5, RADIUS_TOLERANCE, "flow speed at 1e6 is 4.5")
    expect_close(cg.reaction_flow_speed(1.0e9), 4.5, RADIUS_TOLERANCE, "flow speed above 1e6 stays at 4.5")
    expect_close(cg.reaction_arrow_thickness(0.0), 5.0, RADIUS_TOLERANCE, "thickness for rate 0 is the minimum 5 px")
    expect_close(cg.reaction_arrow_thickness(1.0e2), 12.5, RADIUS_TOLERANCE, "thickness at rate 1e2 is 12.5 px")
    expect_close(cg.reaction_arrow_thickness(1.0e4), 16.25, RADIUS_TOLERANCE, "thickness at rate 1e4 is 16.25 px")
    expect_close(cg.reaction_arrow_thickness(1.0e12), 20.0, RADIUS_TOLERANCE, "thickness above 1e6 stays at 20 px")
    mut raised_value_error = False
    try:
        let _ = cg.reaction_arrow_thickness(float("nan"))
    except ValueError:
        raised_value_error = True
    expect_true(raised_value_error, "a NaN rate is ValueError")
    let edge = cg.edge_point_toward(rl.Vector2(100.0, 100.0), 50.0, rl.Vector2(100.0, 300.0))
    expect_true(edge.x == 100.0 and edge.y == 150.0, "edge_point_toward goes radius toward the target")
    let same = cg.edge_point_toward(rl.Vector2(100.0, 100.0), 50.0, rl.Vector2(100.0, 100.0))
    expect_true(same.x == 100.0 and same.y == 100.0, "edge_point_toward returns the center when the target is the center")

# ---- 反応の矢印の描画の確認に使う場面（窓 800 x 600）----
# 基質 "A"（中心 (160, 300)・半径 12.5）→ 反応の中心 (400, 300) → 生成物 "B"（中心 (640, 300)・半径 12.5）、反応速度 1e2（太さ 12.5）
#   基質 → 中心: (172.5, 300) → (400, 300)。曲率 0.5 / 227.5 で、右向きに進んで左へ曲がるので弧は下へ約 14 px 膨らむ（頂点 x = 286）
#   中心 → 生成物: (400, 300) → (627.5, 300)。同じく下へ膨らみ、矢じり（長さ・幅 50）は x = 577.5〜627.5

# reaction_scene_species — 反応の矢印の場面の化学種（A・B とも量 0.001 で半径 12.5）
#   戻り値: [A, B]
# 例: reaction_scene_species()
fn reaction_scene_species() -> list[cg.Species]:
    mut substrate = cg.Adsorbate(name = "A", pos = cg.Position(0.2, 0.5), quantity = 0.001, color = BLUE_COLOR)   # mut: let だと写しも不変で動かせない
    mut product = cg.Adsorbate(name = "B", pos = cg.Position(0.8, 0.5), quantity = 0.001, color = ORANGE_COLOR)
    mut scene: list[cg.Species] = [substrate, product]
    return scene

# make_scene_reaction — 反応の矢印の場面の反応 A → B（中心は窓の中央）
#   戻り値: Reaction
# 例: make_scene_reaction().draw(reaction_scene_species(), 100.0, 0.0, False, WINDOW_WIDTH, WINDOW_HEIGHT)
fn make_scene_reaction() -> cg.Reaction:
    let rate_coefficient = cg.Fn_RateCoefficient(constant_rate_coefficient)
    let species = reaction_scene_species()
    return cg.Reaction([cg.Stoichiometry(species[0], 1)], [cg.Stoichiometry(species[1], 1)], rate_coefficient, rate_coefficient, cg.Position(0.5, 0.5))

# check_reaction_scene — 反応の矢印の画素を確かめる（make_scene_reaction を描いた直後、end_drawing の前に呼ぶ）
# 例: check_reaction_scene()
fn check_reaction_scene() -> None:
    expect_pixel(400, 300, cg.REACTION_CENTER_COLOR, "the reaction center has a dot")
    expect_true(not same_rgb(rl.read_screen_pixel(286, 314) mustbe rl.Color, BACKGROUND_COLOR), "the substrate -> center line bulges about 14 px downward (gentle arc)")
    expect_pixel(286, 290, BACKGROUND_COLOR, "the substrate -> center line is not straight on the chord")
    expect_true(not same_rgb(rl.read_screen_pixel(514, 314) mustbe rl.Color, BACKGROUND_COLOR), "the center -> product arrow bulges downward too")
    expect_pixel(600, 316, cg.REACTION_ARROW_END_COLOR, "the center -> product arrow has a head (end color) near the product")
    expect_pixel(385, 316, BACKGROUND_COLOR, "the substrate -> center line has no head at the center")
    expect_pixel(300, 300, BACKGROUND_COLOR, "nothing is drawn between the line and the chord")

# check_backward_reaction_scene — 逆向き（is_backward = True）の矢印の画素を確かめる（生成物 → 中心 → 基質）
#   生成物 → 中心: (627.5, 300) → (400, 300)。左向きに進んで左へ曲がるので弧は上へ膨らむ。中心の側に矢じりは無い
#   中心 → 基質: (400, 300) → (172.5, 300)。上へ膨らみ、矢じりは基質の手前 x = 172.5〜222.5
# 例: check_backward_reaction_scene()
fn check_backward_reaction_scene() -> None:
    expect_pixel(200, 284, cg.REACTION_ARROW_END_COLOR, "backward: the head (end color) is near the substrate")
    expect_pixel(600, 316, BACKGROUND_COLOR, "backward: no head near the product")
    expect_pixel(600, 284, BACKGROUND_COLOR, "backward: no head on the product side at all")
    expect_pixel(415, 284, BACKGROUND_COLOR, "backward: the product -> center line has no head at the center")
    expect_true(not same_rgb(rl.read_screen_pixel(514, 286) mustbe rl.Color, BACKGROUND_COLOR), "backward: the line bulges upward")

# draw_reaction_frames — 反応の矢印の場面を FRAME_COUNT フレーム描き、最後のフレームで check_reaction_scene を呼ぶ。
#   反応の化学種が並びに無いと ValueError になることも確かめる
# 例: draw_reaction_frames()
fn draw_reaction_frames() -> None:
    let reaction = make_scene_reaction()
    mut frame_index = 0
    while frame_index < FRAME_COUNT:
        rl.begin_drawing()
        rl.clear_background(BACKGROUND_COLOR)
        reaction.draw(reaction_scene_species(), 100.0, 0.0, False, WINDOW_WIDTH, WINDOW_HEIGHT)
        cg.draw_species_list(reaction_scene_species(), None, WINDOW_WIDTH, WINDOW_HEIGHT)
        if frame_index == FRAME_COUNT - 1:
            check_reaction_scene()
        rl.end_drawing()
        frame_index += 1
    rl.begin_drawing()
    rl.clear_background(BACKGROUND_COLOR)
    reaction.draw(reaction_scene_species(), 100.0, 0.0, True, WINDOW_WIDTH, WINDOW_HEIGHT)
    cg.draw_species_list(reaction_scene_species(), None, WINDOW_WIDTH, WINDOW_HEIGHT)
    check_backward_reaction_scene()
    rl.end_drawing()
    let only_substrate: list[cg.Species] = [reaction_scene_species()[0]]
    mut raised_value_error = False
    rl.begin_drawing()
    try:
        reaction.draw(only_substrate, 100.0, 0.0, False, WINDOW_WIDTH, WINDOW_HEIGHT)
    except ValueError:
        raised_value_error = True
    rl.end_drawing()
    expect_true(raised_value_error, "drawing a reaction whose product is not in the species list is ValueError")

# ---- ばねの動き（窓は使わない）----
# 場面は反応の矢印の場面と同じ: A（中心 (160, 300)・半径 12.5・質量 0.015625）→ 反応の中心 (400, 300) → B（中心 (640, 300)）
#   矢印の長さ = 400 - 160 - 12.5 = 227.5 px → 自然長 100 px より 127.5 px 長い → A は右へ 10 × 127.5 = 1275 の力で引かれる

const SPRING_TOLERANCE = 1e-3         # 位置・速度の許容差（座標は float32 の rl.Vector2 を通る）
const FRAME_SECONDS = 1.0 / 60.0

# momentum_x — 化学種と反応の中心の運動量の x 成分の和
#   species_list, reactions: 並び
#   戻り値: Σ 質量 × 速度の x
# 例: momentum_x(species, reactions)
fn momentum_x(let species_list: list[cg.Species], let reactions: list[cg.Reaction]) -> float:
    mut total = 0.0
    for species in species_list:
        total += species.get_mass() * species.get_velocity().x
    for reaction in reactions:
        total += reaction.get_mass() * reaction.get_velocity().x
    return total

# check_spring_layout — 7. 質量・ばねの力・1 フレームの動き・運動量・時間の頭打ち・自然長への収束
# 例: check_spring_layout()
fn check_spring_layout() -> None:
    expect_close(cg.mass_for_radius(100.0), 1.0, RADIUS_TOLERANCE, "mass of radius 100 (quantity 1) is 1")
    expect_close(cg.mass_for_radius(50.0), 0.5, RADIUS_TOLERANCE, "mass is proportional to the radius (radius 50 -> 0.5)")
    let half_species = cg.Adsorbate(name = "half", pos = cg.Position(0.5, 0.5), quantity = 0.5, color = BLUE_COLOR)
    expect_close(make_scene_reaction().get_mass(), half_species.get_mass(), RADIUS_TOLERANCE, "the reaction center weighs as much as a species of quantity 0.5")
    let moved = cg.Position(0.5, 0.5).moved_by_pixels(80.0, -60.0, WINDOW_WIDTH, WINDOW_HEIGHT).to_screen(WINDOW_WIDTH, WINDOW_HEIGHT)
    expect_true(abs(moved.x - 480.0) <= SPRING_TOLERANCE and abs(moved.y - 240.0) <= SPRING_TOLERANCE, "moved_by_pixels shifts by pixels")

    let stretched = cg.spring_force_on_species(rl.Vector2(400.0, 300.0), rl.Vector2(160.0, 300.0), 12.5)
    expect_true(abs(stretched[0] - 1275.0) <= SPRING_TOLERANCE and stretched[1] == 0.0, "a stretched spring pulls the species toward the center: " + str(stretched[0]))
    let resting = cg.spring_force_on_species(rl.Vector2(400.0, 300.0), rl.Vector2(287.5, 300.0), 12.5)
    expect_true(abs(resting[0]) <= SPRING_TOLERANCE and abs(resting[1]) <= SPRING_TOLERANCE, "no force at the rest length (arrow 100 px)")
    let compressed = cg.spring_force_on_species(rl.Vector2(400.0, 300.0), rl.Vector2(350.0, 300.0), 12.5)
    expect_true(abs(compressed[0] + 625.0) <= SPRING_TOLERANCE, "a compressed spring pushes the species away: " + str(compressed[0]))

    mut species_list = reaction_scene_species()
    mut reactions: list[cg.Reaction] = [make_scene_reaction()]
    expect_true(species_list[0].get_velocity().x == 0.0 and reactions[0].get_velocity().x == 0.0, "velocities start at 0")
    cg.advance_spring_layout(species_list, reactions, FRAME_SECONDS, WINDOW_WIDTH, WINDOW_HEIGHT)
    let repulsion_on_a = -cg.repulsion_magnitude(480.0)                             # A は B（480 px 右）から左へ押される
    let expected_speed = (1275.0 + repulsion_on_a) / species_list[0].get_mass() * FRAME_SECONDS
    expect_close(species_list[0].get_velocity().x, expected_speed, SPRING_TOLERANCE, "one frame: A speeds toward the center ((spring + repulsion) / m × Δt)")
    expect_close(species_list[1].get_velocity().x, -expected_speed, SPRING_TOLERANCE, "one frame: B speeds toward the center from the other side")
    expect_close(reactions[0].get_velocity().x, 0.0, SPRING_TOLERANCE, "one frame: the forces on the symmetric center cancel")
    expect_close(species_list[0].get_screen_center(WINDOW_WIDTH, WINDOW_HEIGHT).x, 160.0 + expected_speed * FRAME_SECONDS, SPRING_TOLERANCE, "one frame: A moves by the new velocity × Δt")

    mut long_frame_species = reaction_scene_species()
    mut long_frame_reactions: list[cg.Reaction] = [make_scene_reaction()]
    cg.advance_spring_layout(long_frame_species, long_frame_reactions, 1.0, WINDOW_WIDTH, WINDOW_HEIGHT)
    expect_close(long_frame_species[0].get_velocity().x, expected_speed, SPRING_TOLERANCE, "a long frame (1 s) advances only MAX_SPRING_TIME_STEP")

    # 重さの違う 2 つ（A は量 1、B は量 0.001）: 反応の中心にも力が残るが、運動量の和は 0 のまま
    mut uneven_species: list[cg.Species] = [cg.Adsorbate(name = "A", pos = cg.Position(0.2, 0.5), quantity = 1.0, color = BLUE_COLOR), reaction_scene_species()[1]]
    mut uneven_reactions: list[cg.Reaction] = [make_scene_reaction()]
    cg.advance_spring_layout(uneven_species, uneven_reactions, FRAME_SECONDS, WINDOW_WIDTH, WINDOW_HEIGHT)
    expect_true(abs(uneven_reactions[0].get_velocity().x) > 1.0, "uneven arrows leave a net force on the reaction center")
    expect_true(abs(momentum_x(uneven_species, uneven_reactions)) <= SPRING_TOLERANCE, "the total momentum stays 0 (action and reaction)")

    mut frame_index = 0
    while frame_index < 600:
        cg.advance_spring_layout(species_list, reactions, FRAME_SECONDS, WINDOW_WIDTH, WINDOW_HEIGHT)
        frame_index += 1
    let center = reactions[0].get_screen_center(WINDOW_WIDTH, WINDOW_HEIGHT)
    let arrow_length = cg.distance_between(center, species_list[0].get_screen_center(WINDOW_WIDTH, WINDOW_HEIGHT)) - species_list[0].get_radius()
    let pair_distance = cg.distance_between(species_list[0].get_screen_center(WINDOW_WIDTH, WINDOW_HEIGHT), species_list[1].get_screen_center(WINDOW_WIDTH, WINDOW_HEIGHT))
    let expected_stretch = cg.repulsion_magnitude(pair_distance) / cg.SPRING_CONSTANT   # 反発とつり合う分だけ伸びる
    expect_close(arrow_length, cg.REACTION_ARROW_REST_LENGTH + expected_stretch, 0.5, "after 10 s the arrow settles where the spring balances the repulsion")
    expect_true(abs(species_list[0].get_velocity().x) < 1.0, "after 10 s the species is nearly at rest")


    # 化学種どうしの反発（-2 乗と -6 乗の項の和・頭打ちあり・強さは一定）
    let repelled = cg.spring_force_on_species(rl.Vector2(0.0, 0.0), rl.Vector2(0.0, 0.0), 0.0)
    expect_true(repelled[0] == 0.0 and repelled[1] == 0.0, "no spring force when the centers coincide")
    expect_close(cg.repulsion_magnitude(400.0), cg.REPULSION_CONSTANT / 400.0 ** 2 + cg.CLOSE_REPULSION_CONSTANT / 400.0 ** 6, SPRING_TOLERANCE, "repulsion is the sum of the d^-2 and d^-6 terms")
    let far_inverse_square = cg.REPULSION_CONSTANT / 600.0 ** 2
    expect_true(cg.CLOSE_REPULSION_CONSTANT / 600.0 ** 6 < 0.01 * far_inverse_square, "far away (600 px) the d^-6 term is below 1 % of the d^-2 term")
    expect_true(cg.CLOSE_REPULSION_CONSTANT / 130.0 ** 6 > cg.REPULSION_CONSTANT / 130.0 ** 2, "close (130 px) the d^-6 term is larger than the d^-2 term")
    expect_true(cg.repulsion_magnitude(130.0) / cg.repulsion_magnitude(260.0) > 8.0, "halving the distance from 260 to 130 px raises the force more than 8 times (d^-2 alone gives 4)")
    expect_close(cg.repulsion_magnitude(80.0), cg.MAX_REPULSION_FORCE, SPRING_TOLERANCE, "very close (80 px) the force stops at MAX_REPULSION_FORCE")
    expect_close(cg.repulsion_magnitude(5.0), cg.MAX_REPULSION_FORCE, SPRING_TOLERANCE, "closer than REPULSION_MIN_DISTANCE the force is still the cap")
    let pushed = cg.repulsion_force_on_species(rl.Vector2(600.0, 300.0), rl.Vector2(200.0, 300.0))
    expect_close(pushed[0], cg.repulsion_magnitude(400.0), SPRING_TOLERANCE, "repulsion_force_on_species has the magnitude, away from the other")
    let pushed_up = cg.repulsion_force_on_species(rl.Vector2(200.0, 200.0), rl.Vector2(200.0, 300.0))
    expect_true(pushed_up[1] < 0.0 and abs(pushed_up[0]) <= SPRING_TOLERANCE, "repulsion points from the other species to the pushed one")
    let pushed_same = cg.repulsion_force_on_species(rl.Vector2(200.0, 300.0), rl.Vector2(200.0, 300.0))
    expect_true(pushed_same[0] == 0.0 and pushed_same[1] == 0.0, "no repulsion when the centers coincide")
    # 反応でつながっていない 2 つ（重さが違う）は離れていき、運動量の和は 0 のまま。強さは大きさによらないので加速度は質量に反比例
    mut lonely_species: list[cg.Species] = [cg.Adsorbate(name = "heavy", pos = cg.Position(0.45, 0.5), quantity = 1.0, color = BLUE_COLOR), cg.Adsorbate(name = "light", pos = cg.Position(0.55, 0.5), quantity = 0.001, color = ORANGE_COLOR)]
    mut no_reactions: list[cg.Reaction] = []
    cg.advance_spring_layout(lonely_species, no_reactions, FRAME_SECONDS, WINDOW_WIDTH, WINDOW_HEIGHT)
    expect_true(lonely_species[0].get_velocity().x < 0.0 and lonely_species[1].get_velocity().x > 0.0, "two unconnected species push each other apart")
    expect_true(abs(momentum_x(lonely_species, no_reactions)) <= SPRING_TOLERANCE, "repulsion keeps the total momentum 0")
    expect_close(lonely_species[1].get_velocity().x / -lonely_species[0].get_velocity().x, lonely_species[0].get_mass() / lonely_species[1].get_mass(), SPRING_TOLERANCE, "the same force: the lighter (smaller) species moves faster by the mass ratio")

    let missing_species: list[cg.Species] = [reaction_scene_species()[0]]
    mut raised_value_error = False
    try:
        mut missing_copy = missing_species
        cg.advance_spring_layout(missing_copy, reactions, FRAME_SECONDS, WINDOW_WIDTH, WINDOW_HEIGHT)
    except ValueError:
        raised_value_error = True
    expect_true(raised_value_error, "a reaction species missing from the list is ValueError")

# ---- 本体 ----
check_radius()
check_position()
check_hit_test()
check_arrow_scaling()
check_spring_layout()

rl.set_trace_log_level(rlc.LOG_WARNING)
rl.set_config_flags(rlc.FLAG_WINDOW_HIDDEN)
rl.init_window(WINDOW_WIDTH, WINDOW_HEIGHT, "test_chemical_graphs".encode("utf-8"))
rl.set_target_fps(60)
check_label_color_and_mark_position()
draw_scene_frames(0)
draw_scene_frames(None)
check_index_out_of_range()
draw_reaction_frames()
rl.close_window()
print("all chemical_graphs checks passed")
