# test_raylib_bridge.ar — raylib_bridge.dll（raylib の中継 DLL）を Arrow から呼べることを確かめる自動テスト
#
# 実行: arrow tests/test_raylib_bridge.ar（tests/run_tests.ps1 が tests/test_*.ar をまとめて走らせる）
# 前提: raylib_bridge/install_raylib.ps1 → raylib_bridge/build.ps1 で raylib_bridge.dll を作ってあること。
#
# 見ること（raylib_bridge.h の関数をすべて 1 回以上呼ぶ）:
#   1. 非表示のウィンドウを開き、大きさ・状態を取得できる（int / bool の戻り値）
#   2. 図形と文字を描き、描いた画素を read_screen_pixel で読み戻すと期待どおりの色になる
#      （Color・Vector2 の値渡し、const char* への bytes、Color の値返し）
#   3. グラフ描画用の関数（draw_filled_circle・draw_curved_arrow・draw_curved_arrow_three_colors・
#      draw_curved_arrow_flowing）が、指定どおりの位置・色（2 色 / 3 色のグラデーション・流れる向きと量）・
#      曲がる向きで描き、
#      範囲外の曲率は半円に切り詰め、描けない入力（同じ 2 点・太さ 0・半径 0）では何も描かない
#   3b. 矢じりの無い流れる線（draw_curved_line_flowing）は軸が終点まで届き、矢じりが無い。今のフレームを PNG に保存できる
#   4. マウス位置（Vector2 の値返し）・時間（float / double）・入力の関数を呼べる
#   5. ウィンドウを閉じられる
# 期待と違えば RuntimeError を raise して非 0 で終わる。

import[cpp-dll] ..raylib_bridge.raylib_bridge as rl
import ..raylib_bridge.raylib_consts as rlc
import[py] os

const WINDOW_WIDTH = 480
const WINDOW_HEIGHT = 360
const FRAME_COUNT = 3              # 最後のフレームで画素を確かめる
const TEXT_X = 20
const TEXT_Y = 100
const TEXT_SIZE = 20

let BACKGROUND_COLOR = rl.Color(245, 245, 245, 255)
let RECTANGLE_COLOR = rl.Color(230, 41, 55, 255)
let CIRCLE_COLOR = rl.Color(0, 121, 241, 255)
let LINE_COLOR = rl.Color(0, 158, 47, 255)
let TRIANGLE_COLOR = rl.Color(135, 60, 190, 255)
let OUTLINE_COLOR = rl.Color(40, 40, 40, 255)
let NODE_COLOR = rl.Color(255, 161, 0, 255)
let ARROW_START_COLOR = rl.Color(255, 0, 0, 255)
let ARROW_END_COLOR = rl.Color(0, 0, 255, 255)
let ARROW_START_END_MIXED_COLOR = rl.Color(128, 0, 128, 255)    # ARROW_START_COLOR と ARROW_END_COLOR の中間
let TRICOLOR_MIDDLE_COLOR = rl.Color(0, 255, 0, 255)            # draw_curved_arrow_three_colors の middle_color
let TRICOLOR_START_MIDDLE_MIXED_COLOR = rl.Color(128, 128, 0, 255)  # ARROW_START_COLOR と TRICOLOR_MIDDLE_COLOR の中間
let TRICOLOR_MIDDLE_END_MIXED_COLOR = rl.Color(0, 128, 128, 255)    # TRICOLOR_MIDDLE_COLOR と ARROW_END_COLOR の中間
const GRADIENT_TOLERANCE = 40                         # グラデーションの画素の色の許容差（各チャンネル）
const FLOW_PHASE = 0.25                               # draw_curved_arrow_flowing の flow_phase（1/4 周ずれる）
const LARGE_FLOW_PHASE = 1000.25                      # 小数部が FLOW_PHASE と同じ大きな値（長時間動かした後）

# color_text — 色を "r,g,b,a" の文字列にする（エラーメッセージ用）
#   color: 文字列にする色
#   戻り値: "230,41,55,255" の形の文字列
# 例: color_text(RECTANGLE_COLOR) == "230,41,55,255"
fn color_text(let color: rl.Color) -> str:
    return str(color.r) + "," + str(color.g) + "," + str(color.b) + "," + str(color.a)

# expect_true — 条件が偽なら RuntimeError を投げ、真なら OK を表示する
#   condition: 確かめる条件
#   label:     表示とエラーメッセージに出す説明
# 例: expect_true(rl.is_window_ready(), "is_window_ready after init_window")
fn expect_true(let condition: bool, let label: str) -> None:
    if not condition:
        raise RuntimeError("FAILED: " + label)
    print("OK:", label)

# same_rgb — 2 つの色の r, g, b が等しいか（read_screen_pixel のアルファは常に 255 なので比べない）
#   actual, expected: 比べる色
#   戻り値: r, g, b がすべて等しければ True
# 例: same_rgb(rl.Color(1, 2, 3, 255), rl.Color(1, 2, 3, 0)) == True
fn same_rgb(let actual: rl.Color, let expected: rl.Color) -> bool:
    return actual.r == expected.r and actual.g == expected.g and actual.b == expected.b

# expect_pixel — 今のフレームの画素 (x, y) が期待の色か確かめる（begin_drawing と end_drawing の間で呼ぶ）
#   x, y:     画素の位置（ウィンドウの左上が (0, 0)）
#   expected: 期待する色
#   label:    表示とエラーメッセージに出す説明
# 例: expect_pixel(30, 30, RECTANGLE_COLOR, "draw_rectangle_v")
fn expect_pixel(let x: int, let y: int, let expected: rl.Color, let label: str) -> None:
    let actual = rl.read_screen_pixel(x, y) mustbe rl.Color
    let position_text = "(" + str(x) + ", " + str(y) + ")"
    let detail = position_text + " is " + color_text(actual) + ", expected " + color_text(expected)
    expect_true(same_rgb(actual, expected), label + ": pixel " + detail)

# expect_pixel_near — 今のフレームの画素 (x, y) の r, g, b が、期待の色からそれぞれ tolerance 以内か確かめる
#   （グラデーションの途中の画素のように、丸めで 1〜数段ずれる色を見る）
#   x, y:      画素の位置（ウィンドウの左上が (0, 0)）
#   expected:  期待する色
#   tolerance: 各チャンネルの許容差
#   label:     表示とエラーメッセージに出す説明
# 例: expect_pixel_near(384, 150, ARROW_MIDDLE_COLOR, GRADIENT_TOLERANCE, "gradient middle")
fn expect_pixel_near(let x: int, let y: int, let expected: rl.Color, let tolerance: int, let label: str) -> None:
    let actual = rl.read_screen_pixel(x, y) mustbe rl.Color
    let channel_gap = max(abs(actual.r - expected.r), abs(actual.g - expected.g), abs(actual.b - expected.b))
    let position_text = "(" + str(x) + ", " + str(y) + ")"
    let detail = position_text + " is " + color_text(actual) + ", expected " + color_text(expected) + " +/- " + str(tolerance)
    expect_true(channel_gap <= tolerance, label + ": pixel " + detail)

# expect_drawn — 今のフレームの画素 (x, y) が背景色でない（何か描かれている）か確かめる
#   x, y:  画素の位置（ウィンドウの左上が (0, 0)）
#   label: 表示とエラーメッセージに出す説明
# 例: expect_drawn(400, 248, "curved arrow bulges downward")
fn expect_drawn(let x: int, let y: int, let label: str) -> None:
    let actual = rl.read_screen_pixel(x, y) mustbe rl.Color
    let position_text = "(" + str(x) + ", " + str(y) + ")"
    expect_true(not same_rgb(actual, BACKGROUND_COLOR), label + ": pixel " + position_text + " is " + color_text(actual))

# count_dark_pixels — 横 1 行の区間 [x_start, x_end) にある暗い画素（r, g, b < 100）の数を数える
#   y:              行の位置
#   x_start, x_end: 数える区間（x_end は含まない）
#   戻り値: 暗い画素の数
# 例: count_dark_pixels(TEXT_Y + TEXT_SIZE // 2, TEXT_X, TEXT_X + 30)   # 文字の縦線の画素が数えられる
fn count_dark_pixels(let y: int, let x_start: int, let x_end: int) -> int:
    mut dark_count = 0
    mut x = x_start
    while x < x_end:
        let pixel = rl.read_screen_pixel(x, y) mustbe rl.Color
        if pixel.r < 100 and pixel.g < 100 and pixel.b < 100:
            dark_count += 1
        x += 1
    return dark_count

# draw_test_scene — 画素を確かめる図形と文字を 1 フレーム分描く（begin_drawing と end_drawing の間で呼ぶ）
#   重ならないように置く: 長方形は左上、円は中央、輪郭の円は右上、三角形は右下、線は左下、文字は左の中ほど。
# 例: rl.begin_drawing(); draw_test_scene(); rl.end_drawing()
fn draw_test_scene() -> None:
    rl.clear_background(BACKGROUND_COLOR)
    rl.draw_rectangle_v(rl.Vector2(10.0, 10.0), rl.Vector2(40.0, 40.0), RECTANGLE_COLOR)
    rl.draw_circle_v(rl.Vector2(160.0, 120.0), 30.0, CIRCLE_COLOR)
    rl.draw_circle_lines_v(rl.Vector2(260.0, 60.0), 20.0, OUTLINE_COLOR)
    rl.draw_line_ex(rl.Vector2(20.0, 200.0), rl.Vector2(140.0, 200.0), 8.0, LINE_COLOR)
    # 画面上で反時計回り（上 → 左下 → 右下）。時計回りだと raylib は描かない。
    rl.draw_triangle(rl.Vector2(260.0, 150.0), rl.Vector2(230.0, 210.0), rl.Vector2(290.0, 210.0), TRIANGLE_COLOR)
    rl.draw_text("HHH".encode("utf-8"), TEXT_X, TEXT_Y, TEXT_SIZE, OUTLINE_COLOR)
    rl.draw_fps(10, 60)

# check_test_scene — draw_test_scene が描いた画素を確かめる（draw_test_scene の直後、end_drawing の前に呼ぶ）
# 例: draw_test_scene(); check_test_scene(); rl.end_drawing()
fn check_test_scene() -> None:
    expect_pixel(300, 120, BACKGROUND_COLOR, "clear_background")
    expect_pixel(30, 30, RECTANGLE_COLOR, "draw_rectangle_v")
    expect_pixel(160, 120, CIRCLE_COLOR, "draw_circle_v")
    expect_pixel(80, 200, LINE_COLOR, "draw_line_ex")
    expect_pixel(260, 190, TRIANGLE_COLOR, "draw_triangle")
    expect_pixel(260, 60, BACKGROUND_COLOR, "draw_circle_lines_v leaves the inside empty")
    expect_true(count_dark_pixels(60, 274, 287) > 0, "draw_circle_lines_v draws the outline near x = 280")
    let text_width = rl.measure_text("HHH".encode("utf-8"), TEXT_SIZE)
    expect_true(text_width > 0, "measure_text returns " + str(text_width))
    let text_row = TEXT_Y + TEXT_SIZE // 2
    expect_true(count_dark_pixels(text_row, TEXT_X, TEXT_X + text_width) > 0, "draw_text draws dark pixels")
    let outside = rl.read_screen_pixel(-1, 5) mustbe rl.Color
    expect_true(outside.a == 0, "read_screen_pixel returns Color(0, 0, 0, 0) outside the window")

# draw_graph_scene — グラフ描画用の関数（draw_filled_circle・draw_curved_arrow・draw_curved_arrow_three_colors・
#   draw_curved_arrow_flowing）を 1 フレーム分描く
#   draw_test_scene の後に呼ぶ（背景は draw_test_scene が塗る）。draw_test_scene が使わない右側（x >= 320）と
#   下側（y >= 215）に置く。各矢印の形は check_graph_scene の説明を見る。
# 例: rl.begin_drawing(); draw_test_scene(); draw_graph_scene(); rl.end_drawing()
fn draw_graph_scene() -> None:
    rl.draw_filled_circle(400.0, 60.0, 25.0, NODE_COLOR)
    # 直線（曲率 0）・右向き・長さ 140・太さ 8 → 矢じりは長さ 32（太さの 4 倍）、軸は x = 330〜438
    rl.draw_curved_arrow(330.0, 150.0, 470.0, 150.0, 8.0, ARROW_START_COLOR, ARROW_END_COLOR, 0.0)
    # 曲率 +0.01（R = 100）・右向き → 左へ曲がる（反時計回り）ので、弧は進む向きの右（下）へ 28.6 膨らむ
    rl.draw_curved_arrow(330.0, 220.0, 470.0, 220.0, 8.0, ARROW_START_COLOR, ARROW_END_COLOR, 0.01)
    # 曲率 -0.01・右向き → 右へ曲がるので、弧は上へ 28.6 膨らむ
    rl.draw_curved_arrow(330.0, 330.0, 470.0, 330.0, 8.0, ARROW_START_COLOR, ARROW_END_COLOR, -0.01)
    # 曲率 1.0 は 2 点（距離 80）を通る円弧が無い（上限 2 / 80）→ 半円（R = 40）。左向きなので上へ 40 膨らむ
    rl.draw_curved_arrow(100.0, 340.0, 20.0, 340.0, 6.0, ARROW_START_COLOR, ARROW_END_COLOR, 1.0)
    # 描けない入力: 同じ 2 点・太さ 0・半径 0 → 何も描かない
    rl.draw_curved_arrow(200.0, 300.0, 200.0, 300.0, 8.0, ARROW_START_COLOR, ARROW_END_COLOR, 0.0)
    rl.draw_curved_arrow(150.0, 270.0, 250.0, 270.0, 0.0, ARROW_START_COLOR, ARROW_END_COLOR, 0.0)
    rl.draw_filled_circle(200.0, 330.0, 0.0, NODE_COLOR)
    # 3 色・直線・右向き（y = 110）: 軸は x = 330〜438、その中央 x = 384 が middle_color
    rl.draw_curved_arrow_three_colors(330.0, 110.0, 470.0, 110.0, 8.0, ARROW_START_COLOR, TRICOLOR_MIDDLE_COLOR, ARROW_END_COLOR, 0.0)
    # 3 色・曲率 -0.01（R = 100）・(160, 250) → (300, 250): 弧は上へ 28.6 膨らむ（頂点 (230, 221.4)）。
    #   弧長 155.1・矢じり 32 → 軸 123.1。軸の中央（始点から弧長 61.5）は (214.1, 222.7) で、弧の中央 (230, 221.4) ではない
    rl.draw_curved_arrow_three_colors(160.0, 250.0, 300.0, 250.0, 8.0, ARROW_START_COLOR, TRICOLOR_MIDDLE_COLOR, ARROW_END_COLOR, -0.01)
    # 描けない入力: 太さ 0 → 何も描かない
    rl.draw_curved_arrow_three_colors(150.0, 285.0, 250.0, 285.0, 0.0, ARROW_START_COLOR, TRICOLOR_MIDDLE_COLOR, ARROW_END_COLOR, 0.0)
    # 流れる・直線・右向き（y = 185）・flow_phase 0.25: 軸 x = 330〜438 に 赤→緑→青→赤 の 1 周が並び、1/4 周（27 px）
    #   矢じり側へずれる → 赤は x = 357、緑は x = 393、青は x = 429
    rl.draw_curved_arrow_flowing(330.0, 185.0, 470.0, 185.0, 8.0, ARROW_START_COLOR, TRICOLOR_MIDDLE_COLOR, ARROW_END_COLOR, 0.0, FLOW_PHASE)
    # 流れる・直線・右向き（y = 240）・flow_phase 1000.25（小数部 0.25）: 長さ 108 → 矢じり 32・軸 x = 20〜96（76 px）
    #   → 赤は x = 39、緑は x = 64.3、青は x = 89.7
    rl.draw_curved_arrow_flowing(20.0, 240.0, 128.0, 240.0, 8.0, ARROW_START_COLOR, TRICOLOR_MIDDLE_COLOR, ARROW_END_COLOR, 0.0, LARGE_FLOW_PHASE)
    # 矢じりの無い流れる線・直線・右向き（y = 275）・flow_phase 0.25: 軸は終点まで x = 330〜470（140 px）。1/4 周（35 px）ずれて
    #   赤は x = 365、緑は x = 411.7、青は x = 458.3。矢じりがあれば x = 438〜470 に幅 32 の三角形が出る
    rl.draw_curved_line_flowing(330.0, 275.0, 470.0, 275.0, 8.0, ARROW_START_COLOR, TRICOLOR_MIDDLE_COLOR, ARROW_END_COLOR, 0.0, FLOW_PHASE)

# check_graph_scene — draw_graph_scene が描いた画素を確かめる（draw_graph_scene の直後、end_drawing の前に呼ぶ）
#   グラデーション: 直線の矢印の軸は x = 330（始点の色）〜 438（終点の色）で線形に変わり、矢じりは終点の色。
#     3 色の矢印は軸の中央 x = 384 が middle_color で、その前後でそれぞれ線形に変わる。
#     流れる矢印は 始点色→中間色→終点色→始点色 の 1 周が軸に並び、flow_phase の小数部だけ矢じり側へずれる
#     （向きが逆、または flow_phase を無視すると、x = 357 は赤にならない）。
#   曲がる向き: 曲率 > 0 は進む向きに見て左へ曲がる（弧は右側へ膨らむ）。
# 例: draw_graph_scene(); check_graph_scene(); rl.end_drawing()
fn check_graph_scene() -> None:
    expect_pixel(400, 60, NODE_COLOR, "draw_filled_circle: centre")
    expect_pixel(422, 60, NODE_COLOR, "draw_filled_circle: inside the radius")
    expect_pixel(428, 60, BACKGROUND_COLOR, "draw_filled_circle: outside the radius")
    expect_pixel_near(333, 150, ARROW_START_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow: start color near the start")
    expect_pixel_near(384, 150, ARROW_START_END_MIXED_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow: mixed color mid-shaft")
    expect_pixel(460, 150, ARROW_END_COLOR, "draw_curved_arrow: head is the end color")
    expect_pixel(384, 160, BACKGROUND_COLOR, "draw_curved_arrow: shaft is 8 px thick")
    expect_drawn(400, 248, "draw_curved_arrow: curvature > 0 bulges to the right of the direction (down)")
    expect_pixel(400, 220, BACKGROUND_COLOR, "draw_curved_arrow: curved arrow leaves the chord")
    expect_pixel(400, 192, BACKGROUND_COLOR, "draw_curved_arrow: curvature > 0 does not bulge up")
    expect_drawn(400, 302, "draw_curved_arrow: curvature < 0 bulges to the left of the direction (up)")
    expect_pixel(400, 330, BACKGROUND_COLOR, "draw_curved_arrow: curvature < 0 leaves the chord")
    expect_drawn(60, 300, "draw_curved_arrow: too large curvature is clamped to the semicircle")
    expect_pixel(60, 340, BACKGROUND_COLOR, "draw_curved_arrow: the semicircle leaves the chord")
    expect_pixel(200, 300, BACKGROUND_COLOR, "draw_curved_arrow: nothing for the same two points")
    expect_pixel(200, 270, BACKGROUND_COLOR, "draw_curved_arrow: nothing for thickness 0")
    expect_pixel(200, 330, BACKGROUND_COLOR, "draw_filled_circle: nothing for radius 0")
    expect_pixel_near(333, 110, ARROW_START_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow_three_colors: start color near the start")
    expect_pixel_near(357, 110, TRICOLOR_START_MIDDLE_MIXED_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow_three_colors: start and middle mixed at 1/4 of the shaft")
    expect_pixel_near(384, 110, TRICOLOR_MIDDLE_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow_three_colors: middle color at 1/2 of the shaft")
    expect_pixel_near(411, 110, TRICOLOR_MIDDLE_END_MIXED_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow_three_colors: middle and end mixed at 3/4 of the shaft")
    expect_pixel(460, 110, ARROW_END_COLOR, "draw_curved_arrow_three_colors: head is the end color")
    expect_pixel_near(214, 223, TRICOLOR_MIDDLE_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow_three_colors: middle color at 1/2 of a curved shaft")
    expect_pixel(200, 285, BACKGROUND_COLOR, "draw_curved_arrow_three_colors: nothing for thickness 0")
    expect_pixel_near(357, 185, ARROW_START_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow_flowing: start color moved 1/4 toward the head")
    expect_pixel_near(393, 185, TRICOLOR_MIDDLE_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow_flowing: middle color moved 1/4 toward the head")
    expect_pixel_near(429, 185, ARROW_END_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow_flowing: end color moved 1/4 toward the head")
    expect_pixel(460, 185, ARROW_END_COLOR, "draw_curved_arrow_flowing: head stays the end color")
    expect_pixel_near(39, 240, ARROW_START_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow_flowing: large flow_phase uses its fractional part (start)")
    expect_pixel_near(64, 240, TRICOLOR_MIDDLE_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow_flowing: large flow_phase uses its fractional part (middle)")
    expect_pixel_near(89, 240, ARROW_END_COLOR, GRADIENT_TOLERANCE, "draw_curved_arrow_flowing: large flow_phase uses its fractional part (end)")
    expect_pixel_near(365, 275, ARROW_START_COLOR, GRADIENT_TOLERANCE, "draw_curved_line_flowing: start color moved 1/4 along the whole line")
    expect_pixel_near(412, 275, TRICOLOR_MIDDLE_COLOR, GRADIENT_TOLERANCE, "draw_curved_line_flowing: middle color")
    expect_pixel_near(458, 275, ARROW_END_COLOR, GRADIENT_TOLERANCE, "draw_curved_line_flowing: end color (the shaft reaches the end)")
    expect_pixel(460, 285, BACKGROUND_COLOR, "draw_curved_line_flowing: no head (nothing 10 px off the line near the end)")

# check_input_and_timing — 入力と時間の関数を呼び、値の範囲を確かめる（init_window の後に呼ぶ）
# 例: check_input_and_timing()
fn check_input_and_timing() -> None:
    let mouse = rl.get_mouse_position() mustbe rl.Vector2
    print("info: mouse position", mouse.x, mouse.y)
    print("info: mouse left pressed", rl.is_mouse_button_pressed(rlc.MOUSE_BUTTON_LEFT))
    print("info: mouse left down", rl.is_mouse_button_down(rlc.MOUSE_BUTTON_LEFT))
    print("info: space pressed", rl.is_key_pressed(rlc.KEY_SPACE))
    expect_true(not rl.window_should_close(), "window_should_close is False while running")
    expect_true(rl.get_time() > 0.0, "get_time > 0")
    expect_true(rl.get_frame_time() >= 0.0, "get_frame_time >= 0")
    expect_true(rl.get_fps() >= 0, "get_fps >= 0")

# check_save_screen_image — 今のフレームを画像に保存できることを確かめる（begin_drawing と end_drawing の間で呼ぶ）
#   一時ディレクトリ（環境変数 TEMP）に PNG を書き、大きさが 0 でないことを見てから消す
# 例: check_save_screen_image()
fn check_save_screen_image() -> None:
    let image_path = getenv("TEMP") + "\\test_raylib_bridge_screen.png"
    expect_true(rl.save_screen_image(image_path.encode("utf-8")), "save_screen_image returns True")
    mut image_file = open(image_path, "rb")
    let image_length = len(image_file.read())
    image_file.close()
    expect_true(image_length > 0, "save_screen_image writes a non-empty file (" + str(image_length) + " bytes)")
    os.remove(image_path)

# ---- 本体 ----
rl.set_trace_log_level(rlc.LOG_WARNING)
rl.set_config_flags(rlc.FLAG_WINDOW_HIDDEN)
rl.init_window(WINDOW_WIDTH, WINDOW_HEIGHT, "test_raylib_bridge".encode("utf-8"))
expect_true(rl.is_window_ready(), "is_window_ready after init_window")
expect_true(rl.get_screen_width() == WINDOW_WIDTH, "get_screen_width == " + str(WINDOW_WIDTH))
expect_true(rl.get_screen_height() == WINDOW_HEIGHT, "get_screen_height == " + str(WINDOW_HEIGHT))
rl.set_target_fps(60)

mut frame_index = 0
while frame_index < FRAME_COUNT:
    rl.begin_drawing()
    draw_test_scene()
    draw_graph_scene()
    if frame_index == FRAME_COUNT - 1:
        check_test_scene()
        check_graph_scene()
        check_save_screen_image()
    rl.end_drawing()
    frame_index += 1

check_input_and_timing()
rl.close_window()
expect_true(not rl.is_window_ready(), "is_window_ready is False after close_window")
print("all raylib_bridge checks passed")
