import environment as env
# ⚠ rl は chemical_graphs より先に import する。raylib_bridge を import するモジュール（chemical_graphs）を先に import すると、
#   このファイルで構造体を返す関数（rl.get_mouse_position など）を呼んだところで NameError: 'Vector2' is not defined になる
#   （Arrow 0.7.2・2026-11-26 実測）
import[cpp-dll] raylib_bridge.raylib_bridge as rl
import raylib_bridge.raylib_consts as rlc
import chemical_graphs as cg
import kinetics as kn
import slider_panel as sp
import time_series_plot as tsp
import[py] math
import[py] waveform     # このディレクトリの waveform.py（1 フレーム分の sin 波の電位をまとめて計算する）

# 化学種の初期状態。pos は窓の大きさに対する割合（(0, 0) が左上、(1, 1) が右下。初期位置で、反応のばねで動く）、color は円の塗りの色。
# 円の半径は quantity で決まる（1 で 100 px、1/10 ごとに半分、下限 10 px）。
# ⚠ 実行中の量・位置・速度は species_pool（下）が持つ。これらの変数は初期状態と、反応式で化学種を名前で指すためだけに使う
#   （Arrow では list やフィールドに入れると写しになるので、量を 1 か所にまとめている。let にすると写しも不変になり、
#    kn や cg.advance_spring_layout が書き換えられない）
mut vacancy = cg.Adsorbate(
    name = "vacancy",
    pos = cg.Position(0.5, 0.85),
    quantity = 0.0,
    color = rl.Color(130, 130, 130, 255)
)


mut H_ads = cg.Adsorbate(
    name = "H_ads",
    pos = cg.Position(0.5, 0.17),
    quantity = 1.0,
    color = rl.Color(230, 41, 55, 255)
)

mut H2_gas = cg.Solute(
    name = "H2",
    pos = cg.Position(0.88, 0.5),
    quantity = 1.0,
    color = rl.Color(0, 121, 241, 255),
    is_const = True
)

mut proton = cg.Solute(
    name = "H+",
    pos = cg.Position(0.5, 0.5),
    quantity = 1.0,
    color = rl.Color(255, 161, 0, 255),
    is_const = True
)

# 描く順（後ろほど手前）に並べた化学種。反応で量が変わるのはこの中の値（毎フレーム reaction_network.relax が書き換える）
mut species_pool: list[cg.Species] = [vacancy, H_ads, H2_gas, proton]

# 素反応の Butler-Volmer 関係式のパラメータ（⚠ 動きを見るための仮の値。文献値・実測値ではない）
const VOLMER_CENTER_POTENTIAL = -0.1        # Volmer 反応の平衡電位 [V]
const VOLMER_K0 = 1.0                       # Volmer 反応の平衡電位での速度定数 [1/s]
const HEYROVSKY_CENTER_POTENTIAL = 0.1      # Heyrovsky 反応の平衡電位 [V]
const HEYROVSKY_K0 = 0.1                    # Heyrovsky 反応の平衡電位での速度定数 [1/s]
const ELECTRON_TRANSFER_COEFFICIENT = 0.5   # 電荷移動係数 α（両反応で共通）

# Volmer 反応: H+ + e- + * → H_ads（正反応 = 還元）
let volmer_rate_coefficients = kn.butler_volmer_k_pair(VOLMER_CENTER_POTENTIAL, VOLMER_K0, ELECTRON_TRANSFER_COEFFICIENT)
mut volmer = cg.Reaction(
    [cg.Stoichiometry(proton, 1), cg.Stoichiometry(vacancy, 1)],
    [cg.Stoichiometry(H_ads, 1)],
    volmer_rate_coefficients[0],
    volmer_rate_coefficients[1],
    cg.Position(0.3, 0.5)                   # 反応の中心（矢印がここを通る）
)

# Heyrovsky 反応: H_ads + H+ + e- → H2 + *（正反応 = 還元）
let heyrovsky_rate_coefficients = kn.butler_volmer_k_pair(HEYROVSKY_CENTER_POTENTIAL, HEYROVSKY_K0, ELECTRON_TRANSFER_COEFFICIENT)
mut heyrovsky = cg.Reaction(
    [cg.Stoichiometry(H_ads, 1), cg.Stoichiometry(proton, 1)],
    [cg.Stoichiometry(H2_gas, 1), cg.Stoichiometry(vacancy, 1)],
    heyrovsky_rate_coefficients[0],
    heyrovsky_rate_coefficients[1],
    cg.Position(0.7, 0.5)
)

# 反応の並び。中心の位置・速度は cg.advance_spring_layout が毎フレーム書き換える（mut にしておく。let だと要素が不変になる）
mut reactions: list[cg.Reaction] = [volmer, heyrovsky]
let reaction_network = kn.ReactionNetwork(species_pool, reactions)   # 化学種と反応を番号で引く計算用の表（species_pool と同じ並び）

# ---- 電位の時間変化 ----
# 電極の電位 = center_potential + potential_amplitude * sin(2π × phase_cycles)
# 時間は画面の DISPLAY_SECONDS_PER_PERIOD 秒で 1 周期進む（time_scale の周波数によらず、見える速さは一定）。
# シミュレーションの時間は time_scale の周期で決まり、位相は 周波数 × シミュレーションの時間 で進む。
# 1 フレーム（60 FPS で位相 6°）を SUBSTEPS_PER_FRAME 個のサブステップ（0.1°）に分け、サブステップごとに
# 吸着種をその電位の定常状態へ指数的に緩和させる（reaction_network.relax）。描くのはフレームの終わりの量。
const DISPLAY_SECONDS_PER_PERIOD = 1.0      # 画面の何秒で 1 周期を見せるか [s]（固定。time_scale の値に寄与しない）
const SUBSTEPS_PER_FRAME = 60               # 1 フレームのサブステップの数
const INITIAL_FREQUENCY = 10.0              # 周波数の初期値 [Hz]
const INITIAL_AMPLITUDE_MV = 10.0           # sin 波の振幅の初期値 [mV]（スライダーは 0〜100 mV）

mut time_scale = env.TimeScale(env.Frequency(INITIAL_FREQUENCY))   # 周波数と周期（スライダーの窓 controls から書き換える）
mut center_potential = env.Potential(0.0)              # sin 波の中心電位 [V]（スライダーの窓 controls から書き換える）
mut potential_amplitude = INITIAL_AMPLITUDE_MV / 1000.0 # sin 波の振幅 [V]（スライダーの窓 controls から書き換える）
mut simulated_seconds = 0.0                            # シミュレーションの経過時間 [s]（frame_step が進める）
mut phase_cycles = 0.0                                 # sin 波の位相 [周期]（frame_step が 周波数 × シミュレーションの時間刻み だけ進める）
mut electrode_potential = env.Potential(0.0)           # このフレームの最後のサブステップの電位（表示用。frame_step が決める）
mut elapsed_periods = 0.0                              # 始めからの位相 [周期]（phase_cycles と違い 1 で戻さない。frame_step が進める）
mut electrode_potential_periods = 0.0                  # electrode_potential を計算した位相 [周期]（電位の時系列の横軸。frame_step が決める）

# ---- 電位の時系列（別の窓に描く）----
# 過去 POTENTIAL_HISTORY_FRAMES フレームの (位相 [周期], 電位 [V]) を輪のように使う配列に保存する（最初はすべて (0.0, 0.0)）。
# 毎フレーム番号を 1 つずつずらして今の値を入れ、最後の番号の次は 0 番に戻る。窓は最新の点を赤い点で強調する。
const POTENTIAL_HISTORY_FRAMES = 300        # 保存するフレームの数（60 FPS で 5 秒 = 5 周期分）
mut potential_history = tsp.RingSeries(POTENTIAL_HISTORY_FRAMES)

# 反応の矢印のグラデーションの位相 [周期]（reactions と同じ並び。advance_reaction_flows が 速さ × 画面の経過時間 だけ進める）
mut reaction_flow_phases: list[float] = [0.0] * len(reactions)

# クリックで選ばれた化学種の番号（species_pool の並びでの位置）。None なら何も選ばれていない
mut selected_species_index: Option[int] = None

# set_center_potential — 中心電位のスライダーが動いたときに controls.apply_changes() から呼ばれ、center_potential を書き換える
#   value: スライダーの新しい値 [V]
# 例: set_center_potential(-0.2)
fn set_center_potential(let value: float) -> None:
    center_potential = env.Potential(value)

# set_potential_amplitude_mv — 振幅のスライダーが動いたときに controls.apply_changes() から呼ばれ、potential_amplitude を書き換える
#   value: スライダーの新しい値 [mV]
# 例: set_potential_amplitude_mv(25.0)   # potential_amplitude は 0.025 V
fn set_potential_amplitude_mv(let value: float) -> None:
    potential_amplitude = value / 1000.0

# set_log10_frequency — 周波数のスライダー（log10 の目盛り）が動いたときに controls.apply_changes() から呼ばれ、time_scale の周波数を変える
#   value: log10(周波数 / Hz)（-2 で 0.01 Hz、5 で 100 kHz）
# 例: set_log10_frequency(3.0)   # 1 kHz（周期 1 ms）
fn set_log10_frequency(let value: float) -> None:
    time_scale.set_applied_frequency(env.Frequency(10.0 ** value))

# frame_step — 画面の経過時間 display_seconds だけ時間を進め、その間の緩和を SUBSTEPS_PER_FRAME 個のサブステップで計算する
#   display_seconds: 前のフレームからの画面の経過時間 [s]（rl.get_frame_time()。60 FPS なら位相 6°、1 サブステップ 0.1°）
#   ① サブステップごとの電位を Python（waveform.sine_potentials）に 1 回でまとめて計算させる（位相はサブステップの初め）
#   ② reaction_network.relax で、各電位の定常状態への指数的な緩和と吸着種の総和の調整を順に行い、species_pool に書き戻す
#   simulated_seconds・phase_cycles・elapsed_periods・electrode_potential・electrode_potential_periods・species_pool を書き換える
# 例: frame_step(rl.get_frame_time())
fn frame_step(let display_seconds: float) -> None:
    let substep_seconds = time_scale.simulated_time_step(display_seconds / SUBSTEPS_PER_FRAME, DISPLAY_SECONDS_PER_PERIOD) => float
    let phase_step_cycles = (time_scale.get_applied_frequency() => float) * substep_seconds
    mut substep_potentials: list[float] = waveform.sine_potentials(center_potential => float, potential_amplitude, phase_cycles, phase_step_cycles, SUBSTEPS_PER_FRAME) => list[float]
    reaction_network.relax(species_pool, substep_potentials, substep_seconds)
    simulated_seconds += substep_seconds * SUBSTEPS_PER_FRAME
    phase_cycles = (phase_cycles + phase_step_cycles * SUBSTEPS_PER_FRAME) % 1.0
    electrode_potential = env.Potential(substep_potentials[SUBSTEPS_PER_FRAME - 1])
    electrode_potential_periods = elapsed_periods + phase_step_cycles * (SUBSTEPS_PER_FRAME - 1)   # 最後のサブステップの初めの位相
    elapsed_periods += phase_step_cycles * SUBSTEPS_PER_FRAME

# runs_backward — 今の電位・量で、逆反応の速さが正反応の速さより大きいか（矢印の向きを決める。等しければ正反応の向き）
#   reaction: 反応
#   quantities: {名前: 量}（kn.quantities_by_name(species_pool)）
#   戻り値: k_b Π_生成物 q^ν > k_f Π_基質 q^ν なら True
# 例: runs_backward(volmer, kn.quantities_by_name(species_pool))
fn runs_backward(let reaction: cg.Reaction, let quantities: dict[str, float]) -> bool:
    return kn.backward_reaction_rate(reaction, quantities, electrode_potential) > kn.forward_reaction_rate(reaction, quantities, electrode_potential)

# advance_reaction_flows — 反応の矢印のグラデーションの位相を、画面の経過時間 display_seconds だけ進める
#   display_seconds: 前のフレームからの画面の経過時間 [s]
#   速さは今の電位での、速いほうの向き（runs_backward）の速度定数で決まる（cg.reaction_flow_speed: 0.5〜4.5 周期/秒）。
#   reaction_flow_phases を書き換える
# 例: advance_reaction_flows(rl.get_frame_time())
fn advance_reaction_flows(let display_seconds: float) -> None:
    let quantities = kn.quantities_by_name(species_pool)
    for reaction_index in range(len(reactions)):
        mut rate_constant = reactions[reaction_index].forward_rate_coefficient(electrode_potential)
        if runs_backward(reactions[reaction_index], quantities):
            rate_constant = reactions[reaction_index].backward_rate_coefficient(electrode_potential)
        reaction_flow_phases[reaction_index] = (reaction_flow_phases[reaction_index] + cg.reaction_flow_speed(rate_constant) * display_seconds) % 1.0

# draw_reactions — 反応を矢印で描く（速いほうの向きに、出発側 → 中心 → 行き先。begin_drawing と end_drawing の間、化学種の円より先に呼ぶ）
#   screen_width, screen_height: 窓の幅・高さ [pixel]
#   太さは今の電位・量での、速いほうの向きの反応の速さ（速度定数 × 出発側の量の積。cg.reaction_arrow_thickness: 5〜20 px）
# 例: draw_reactions(rl.get_screen_width(), rl.get_screen_height())
fn draw_reactions(let screen_width: int, let screen_height: int) -> None:
    let quantities = kn.quantities_by_name(species_pool)
    for reaction_index in range(len(reactions)):
        let reaction = reactions[reaction_index]
        let forward_rate = kn.forward_reaction_rate(reaction, quantities, electrode_potential)
        let backward_rate = kn.backward_reaction_rate(reaction, quantities, electrode_potential)
        reaction.draw(species_pool, max(forward_rate, backward_rate), reaction_flow_phases[reaction_index], runs_backward(reaction, quantities), screen_width, screen_height)

# draw_status — 窓の左上（題名の下）に、電位と、周波数・シミュレーションの時間を 2 行で描く（begin_drawing と end_drawing の間で呼ぶ）
#   （上の真ん中の H_ads の円に重ならないよう、1 行を短くしている）
# 例: draw_status()
fn draw_status() -> None:
    let potential_line = "E = " + format(electrode_potential => float, "+.4f") + " V (center " + format(center_potential => float, "+.3f") + " V, amplitude " + format(potential_amplitude * 1000.0, ".0f") + " mV)"
    let time_line = "f = " + format(time_scale.get_applied_frequency() => float, ".3g") + " Hz   t = " + format(simulated_seconds, ".4g") + " s"
    rl.draw_text(potential_line.encode("utf-8"), 20, 52, 16, rl.Color(40, 40, 40, 255))
    rl.draw_text(time_line.encode("utf-8"), 20, 72, 16, rl.Color(40, 40, 40, 255))


# update_selection — 左ボタンが押されたフレームなら、クリックされた化学種の番号を selected_species_index に入れる
#   （重なった円では最も手前のもの。どれにも重ならなければ None にして選択を外す）
#   drawn_species: このフレームで描く化学種の並び（species_pool）
#   screen_width, screen_height: 窓の幅・高さ [pixel]
# 例: update_selection(species_pool, rl.get_screen_width(), rl.get_screen_height())
fn update_selection(let drawn_species: list[cg.Species], let screen_width: int, let screen_height: int) -> None:
    if rl.is_mouse_button_pressed(rlc.MOUSE_BUTTON_LEFT):
        let mouse = rl.get_mouse_position() mustbe rl.Vector2
        selected_species_index = cg.find_species_at(drawn_species, mouse, screen_width, screen_height)


rl.set_config_flags(rlc.FLAG_MSAA_4X_HINT)
rl.init_window(1100, 700, "graph_visualizer".encode("utf-8"))
rl.set_target_fps(60)

mut controls = sp.SliderWindow("graph_visualizer controls")
controls.add_slider("center potential [V]", -0.3, 0.3, center_potential => float, set_center_potential, 600)
controls.add_slider("amplitude [mV]", 0.0, 100.0, INITIAL_AMPLITUDE_MV, set_potential_amplitude_mv, 100)
controls.add_slider("log10(frequency / Hz)", -2.0, 5.0, math.log10(INITIAL_FREQUENCY), set_log10_frequency, 700)

mut potential_plot = tsp.TimeSeriesWindow("graph_visualizer potential", POTENTIAL_HISTORY_FRAMES, "Period", "E / V")

mut running = True

while running:
    controls.apply_changes()        # 前のフレームから動いたスライダーの分だけ set_* が呼ばれる
    frame_step(rl.get_frame_time())  # 時間を 1 フレーム進め、サブステップごとの緩和を計算して species_pool に書き戻す
    potential_history.record(electrode_potential_periods, electrode_potential => float)   # 次の番号に今の電位を入れる
    potential_plot.show_newest(potential_history)                                         # 入れた点を電位の窓へ送る（待たない）
    advance_reaction_flows(rl.get_frame_time())
    let screen_width = rl.get_screen_width()
    let screen_height = rl.get_screen_height()
    # 反応のばねで、化学種と反応の中心の 力 → 速度 → 位置 を 1 フレーム分進める（半径は今の量で決まる）
    cg.advance_spring_layout(species_pool, reactions, rl.get_frame_time(), screen_width, screen_height)
    update_selection(species_pool, screen_width, screen_height)
    rl.begin_drawing()
    rl.clear_background(cg.CANVAS_BACKGROUND_COLOR)
    rl.draw_text("graph_visualizer".encode("utf-8"), 20, 20, 24, rl.Color(40, 40, 40, 255))
    draw_status()
    draw_reactions(screen_width, screen_height)     # 矢印を先に描き、化学種の円と文字を上に重ねる
    cg.draw_species_list(species_pool, selected_species_index, screen_width, screen_height)
    rl.end_drawing()
    running = not rl.window_should_close()

controls.close()
potential_plot.close()
rl.close_window()

